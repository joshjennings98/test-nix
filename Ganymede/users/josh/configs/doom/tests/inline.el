                                              'face display) 'shadow)))
              (let* ((display (overlay-get first 'after-string))
                     (index (string-match "Visible first reply" display)))
                (should index)
                (should-not (eq (get-text-property index 'face display) 'shadow)))))
        (dolist (overlay (list first second))
          (when (and overlay (overlay-buffer overlay)) (agent-shell-inline-clear-response-overlay overlay)))
        (kill-buffer a)
        (kill-buffer b)))))

(ert-deftest josh/inline-plain-click-focuses-and-visible-cycle-preserves-view ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (insert "First anchor\nMiddle\nSecond anchor\n")
      (goto-char 1)
      (let* ((first (agent-shell-inline--setup-response-overlay (list :marker (point-marker) :buffer (current-buffer))))
             (second (progn (forward-line 2)
                            (agent-shell-inline--setup-response-overlay (list :marker (point-marker) :buffer (current-buffer)))))
             (window (selected-window)))
        (unwind-protect
            (progn
              (agent-shell-inline--focus-preview first)
              (goto-char 1)
              (let* ((position (point))
                     (start (window-start))
                     (vscroll (window-vscroll))
                     (text (overlay-get second 'after-string))
                     (name (string-match (regexp-quote (buffer-name)) text))
                     (event (list 'down-mouse-1 (list window (overlay-end second) '(0 . 20) 0 (cons text name)))))
                (cl-letf (((symbol-function 'agent-shell-inline--drag-anchor-y) (lambda (_) 0))
                          ((symbol-function 'read-event) (lambda (&rest _) (cons 'mouse-1 (cdr event)))))
                  (funcall (lookup-key (get-text-property name 'keymap text) [down-mouse-1]) event))
                (should (eq agent-shell-inline--focused-preview second))
                (agent-shell-inline--focus-preview first)
                (agent-shell-inline--click (cons 'mouse-1 (cdr event)))
                (should (eq agent-shell-inline--focused-preview second))
                (should (= (point) position))
                (should (= (window-start) start))
                (let ((display (overlay-get second 'after-string)))
                  (should (equal (get-text-property (string-match (regexp-quote (buffer-name)) display)
                                                   'face display) '(bold shadow))))
                (cl-letf (((symbol-function 'pos-visible-in-window-p) (lambda (&rest _) t))
                          ((symbol-function 'recenter) (lambda (&rest _) (ert-fail "Recentred a visible preview"))))
                  (agent-shell-inline-cycle))
                (should (eq agent-shell-inline--focused-preview first))
                (should (eq (selected-window) window))
                (should (= (point) position))
                (should (= (window-start) start))
                (should (= (window-vscroll) vscroll))
                (let (recentred)
                  (cl-letf (((symbol-function 'pos-visible-in-window-p) (lambda (&rest _) nil))
                            ((symbol-function 'recenter) (lambda (&rest _) (setq recentred t))))
                    (agent-shell-inline-cycle))
                  (should recentred)
                  (should (eq agent-shell-inline--focused-preview second))
                  (should (= (point) (overlay-start second))))))
          (agent-shell-inline-clear-response-overlay first)
          (agent-shell-inline-clear-response-overlay second))))))
