(ert-deftest josh/inline-browses-conversation-history ()
  (josh/with-inline-agent
    (let ((first (agent-shell-inline-message "first" shell)))
      (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get first 'agent-shell-inline-status))))
      (agent-shell-inline-clear-response-overlay first))
    (let ((overlay (agent-shell-inline-message "second" shell)))
      (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get overlay 'agent-shell-inline-status))))
      (with-current-buffer shell
        (agent-shell-insert :text "third, from the conversation" :submit t :no-focus t :shell-buffer shell))
      (josh/inline-wait (lambda () (eq (agent-shell-status :shell-buffer shell) 'ready)))
      (let ((position (overlay-start overlay))
            (count (with-current-buffer shell (length (shell-maker-history)))))
        (agent-shell-inline-previous-message overlay)
        (should (eq (current-buffer) source))
        (agent-shell-inline-copy-response)
        (should (string-match-p "first" (current-kill 0)))
        (agent-shell-inline-previous-message overlay)
        (should (= (overlay-get overlay 'agent-shell-inline-history-index) 0))
        (agent-shell-inline-next-message overlay)
        (should-not (overlay-get overlay 'agent-shell-inline-history-source))
        (agent-shell-inline-copy-response)
        (should (string-match-p "second" (current-kill 0)))
        (agent-shell-inline-next-message overlay)
        (agent-shell-inline-copy-response)
        (should (string-match-p "third, from the conversation" (current-kill 0)))
        (agent-shell-inline-next-message overlay)
        (should (= (overlay-get overlay 'agent-shell-inline-history-index) 2))
        (should (= position (overlay-start overlay)))
        (should (= count (with-current-buffer shell (length (shell-maker-history)))))
        (should-not (get-buffer-window shell))
        (let ((history (overlay-get overlay 'agent-shell-inline-history-source)))
          (agent-shell-inline-clear-response-overlay overlay)
          (should-not (buffer-live-p history)))))))

(ert-deftest josh/inline-history-does-not-overwrite-live-stream ()
  (josh/with-inline-agent
    (let ((first (agent-shell-inline-message "first" shell)))
      (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get first 'agent-shell-inline-status))))
      (agent-shell-inline-clear-response-overlay first))
    (let ((overlay (agent-shell-inline-message "TEST_HOLD" shell)))
      (josh/inline-wait (lambda () (eq (agent-shell-status :shell-buffer shell) 'busy)))
      (agent-shell-inline-previous-message overlay)
      (agent-shell-inline--update-response-overlay " still live" overlay)
      (agent-shell-inline-copy-response)
      (should (string-match-p "first" (current-kill 0)))
      (should-not (string-match-p "still live" (current-kill 0)))
      (agent-shell-inline-next-message overlay)
      (agent-shell-inline-copy-response)
      (should (string-match-p "still live" (current-kill 0)))
      (agent-shell-inline-interrupt))))

(ert-deftest josh/inline-wraps-without-changing-source-or-copy ()
  (josh/with-inline-agent
    (setq-local truncate-lines t)
    (let* ((text (mapconcat #'identity (make-list 60 "wrapping") " "))
           (overlay (agent-shell-inline-message text shell))
           (preview (plist-get (overlay-get overlay 'agent-shell-inline) :src)))
      (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get overlay 'agent-shell-inline-status))))
      (let ((raw (with-current-buffer preview (buffer-string)))
            (width (1- (window-body-width))))
        (should truncate-lines)
        (dolist (line (agent-shell-inline--response-lines overlay))
          (should (<= (string-width line) width)))
        (should (> (length (agent-shell-inline--response-lines overlay)) 3))
        (let ((window (split-window-right)))
          (unwind-protect
              (progn
                (agent-shell-inline--render-source-previews)
                (dolist (line (agent-shell-inline--response-lines overlay))
                  (should (< (string-width line) (window-body-width))))
                (agent-shell-inline--response-overlay-scroll-to 2 overlay)
                (should (= (overlay-get overlay 'agent-shell-inline-scroll-index) 2)))
            (delete-window window)))
        (agent-shell-inline-copy-response)
        (should (equal (current-kill 0) raw))
        (should (equal (with-current-buffer preview (buffer-string)) raw))))))

(ert-deftest josh/inline-send-clears-cycled-highlight ()
  (josh/with-inline-agent
    (josh/inline-wait (lambda () (agent-shell-initialized-p :shell-buffer shell)))
    (agent-shell-inline)
    (setq agent-shell-inline--reference-type 'none)
    (agent-shell-inline-cycle-reference)
    (let ((reference (plist-get agent-shell-inline--context :reference-ov)))
      (should (overlay-buffer reference))
      (insert "explain this")
      (agent-shell-inline-send)
      (should-not (overlay-buffer reference))
      (should-not (seq-some (lambda (overlay)
                             (eq (overlay-get overlay 'face) 'secondary-selection))
                           (overlays-in (point-min) (point-max)))))
    (let ((overlay (agent-shell-inline--response-overlay-at-point)))
      (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get overlay 'agent-shell-inline-status))))
      (should-not (plist-get (overlay-get overlay 'agent-shell-inline) :reference-ov))
      (should (with-current-buffer shell (string-match-p "source line" (buffer-string)))))))

(ert-deftest josh/inline-follow-up-keeps-dragged-position ()
  (josh/with-inline-agent
    (let ((destination (generate-new-buffer " *inline-drag-destination*")))
      (unwind-protect
          (let ((overlay (agent-shell-inline-message "first" shell)))
            (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get overlay 'agent-shell-inline-status))))
            (with-current-buffer destination (insert "first line\nsecond line\n"))
            ;; A drag relocates the overlay without moving the source cursor.
            (move-overlay overlay 12 23 destination)
            (agent-shell-inline--setup-response-overlay-keymap overlay destination)
            (overlay-put overlay 'agent-shell-inline-height 12)
            (agent-shell-inline overlay)
            (insert "follow up")
            (agent-shell-inline-send)
            (should (eq (current-buffer) source))
            (should-not (overlay-buffer overlay))
            (switch-to-buffer destination)
            (goto-char 12)
            (setq overlay (agent-shell-inline--response-overlay-at-point))
            (should (overlayp overlay))
            (should (eq (overlay-buffer overlay) destination))
            (should (= (overlay-start overlay) 12))
            (should (= (overlay-get overlay 'agent-shell-inline-height) 12))
            (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get overlay 'agent-shell-inline-status))))
            (should (= (overlay-start overlay) 12)))
        (kill-buffer destination)))))

(ert-deftest josh/inline-busy-keeps-draft-and-interrupts ()
  (josh/with-inline-agent
    (let ((overlay (agent-shell-inline-message "TEST_HOLD" shell)))
      (josh/inline-wait (lambda () (eq (agent-shell-status :shell-buffer shell) 'busy)))
      (let ((prompt (agent-shell-inline)))
        (insert "keep my draft")
        (should-error (agent-shell-inline-send) :type 'user-error)
        (should (buffer-live-p prompt))
        (should (equal (buffer-string) "keep my draft"))
        (agent-shell-inline-quit))
      (cl-letf (((symbol-function 'agent-shell-interrupt-confirmed-p) (lambda () nil)))
        (agent-shell-inline-interrupt)
        (should (eq (agent-shell-status :shell-buffer shell) 'busy))
        (should (plist-get (overlay-get overlay 'agent-shell-inline) :subscription)))
      (agent-shell-inline-interrupt)
      (josh/inline-wait (lambda () (eq (agent-shell-status :shell-buffer shell) 'ready)))
      (should (equal (overlay-get overlay 'agent-shell-inline-status) "Interrupted")))))

