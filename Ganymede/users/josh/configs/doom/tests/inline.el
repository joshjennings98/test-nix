(ert-deftest josh/inline-retains-replies-and-jumps-to-latest ()
  (josh/with-inline-agent
    (let ((first (agent-shell-inline-message "first" shell))
          (other (generate-new-buffer " *inline-mirror*")))
      (unwind-protect
          (progn
            (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get first 'agent-shell-inline-status))))
            (switch-to-buffer other)
            (insert "Other source\n")
            (agent-shell-inline-continue-recent)
            (insert "second")
            (agent-shell-inline-send)
            (let ((second (agent-shell-inline--response-overlay-at-point)))
              (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get second 'agent-shell-inline-status))))
              (should (string-match-p "Echo:.*" (overlay-get first 'after-string)))
              (should (string-match-p "first" (overlay-get first 'after-string)))
              (should-not (string-match-p "second" (overlay-get first 'after-string)))
              (should (string-match-p "1 newer" (overlay-get first 'after-string)))
              (with-current-buffer shell
                (agent-shell-insert :text "third" :submit t :no-focus t :shell-buffer shell))
              (josh/inline-wait (lambda () (eq (agent-shell-status :shell-buffer shell) 'ready)))
              (should (string-match-p "second" (overlay-get second 'after-string)))
              (should (string-match-p "2 newer" (overlay-get first 'after-string)))
              (let* ((text (overlay-get first 'after-string))
