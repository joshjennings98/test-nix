;;; inline.el --- Offline inline/ACP integration tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(load (expand-file-name "../agent-shell-inline.el" (file-name-directory load-file-name)) nil t)

(defconst josh/inline-fixture
  (expand-file-name "mock-acp.py" (file-name-directory load-file-name)))

(defun josh/inline-wait (predicate)
  "Allow asynchronous ACP processing until PREDICATE holds, with a deadline."
  (let ((deadline (+ (float-time) 8)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.02))
    (should (funcall predicate))))

(defmacro josh/with-inline-agent (&rest body)
  "Run BODY with a real Agent Shell using a local deterministic ACP server."
  (declare (indent 0) (debug t))
  `(let* ((default-directory (file-name-as-directory (make-temp-file "inline-acp-" t)))
          (shell-maker-root-path default-directory)
          (agent-shell-transcript-file-path-function nil)
          (agent-shell-show-welcome-message nil)
          (agent-shell-show-busy-indicator nil)
          (agent-shell-inhibit-system-sleep nil)
          (agent-shell-confirm-interrupt nil)
          (shell-maker-prompt-before-killing-buffer nil)
          (agent-shell-header-style 'text)
          (agent-shell-highlight-blocks nil)
          (agent-shell-cwd-function (lambda () default-directory))
          (agent-shell-prefer-viewport-interaction nil)
          (python (or (getenv "AGENT_SHELL_TEST_PYTHON") (executable-find "python3")))
          (source (generate-new-buffer " *inline-source*"))
          shell subscription-count)
     (should python)
     (save-window-excursion
       (unwind-protect
           (progn
             (switch-to-buffer source)
             (insert "source line\n")
             (goto-char (point-min))
             (setq shell
                   (agent-shell--new-shell
                    :location default-directory :no-display t
                    :config (agent-shell-make-agent-config
                             :identifier 'inline-fixture :mode-line-name "Fixture"
                             :buffer-name "Inline fixture" :shell-prompt "Fixture> "
                             :shell-prompt-regexp "Fixture> "
                             :client-maker
                             (lambda (buffer)
                               (acp-make-client :command python
                                                :command-params (list josh/inline-fixture)
                                                :context-buffer buffer)))))
             (setq-local agent-shell-inline--last shell)
             (setq subscription-count
                   (with-current-buffer shell
                     (length (map-elt agent-shell--state :event-subscriptions))))
             ,@body)
         (dolist (buffer (buffer-list))
           (when (and (buffer-live-p buffer)
                      (buffer-local-value 'agent-shell-inline--context buffer)
                      (eq (plist-get (buffer-local-value 'agent-shell-inline--context buffer) :buffer) shell))
             (kill-buffer buffer)))
         (when (buffer-live-p source) (kill-buffer source))
         (when (buffer-live-p shell)
           (with-current-buffer shell
             (setq-local kill-buffer-query-functions nil))
           (kill-buffer shell))))))

(ert-deftest josh/inline-background-and-follow-up ()
  (josh/with-inline-agent
    (let* ((window (selected-window))
           (overlay (agent-shell-inline-message "first" shell))
           (preview (plist-get (overlay-get overlay 'agent-shell-inline) :src)))
      (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get overlay 'agent-shell-inline-status))))
      (should (eq (current-buffer) source))
      (should (eq (selected-window) window))
      (should-not (get-buffer-window shell))
      (should (equal (with-current-buffer preview (string-trim (buffer-string))) "Echo: \n\nfirst"))
      (should-not (buffer-local-value 'agent-shell-inline--active shell))
      (should (= subscription-count
                 (with-current-buffer shell
                   (length (map-elt agent-shell--state :event-subscriptions)))))
      (let ((prompt (agent-shell-inline overlay)))
        (should (eq (plist-get agent-shell-inline--context :buffer) shell))
        (insert "second")
        (agent-shell-inline-send)
        (should-not (buffer-live-p prompt))
        (should-not (overlay-buffer overlay))
        (setq overlay (agent-shell-inline--response-overlay-at-point))
        (should (overlayp overlay))
        (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get overlay 'agent-shell-inline-status))))
        (should (with-current-buffer shell (string-match-p "second" (buffer-string))))
        (should (eq (current-buffer) source))
        (should-not (get-buffer-window shell))))))

(ert-deftest josh/inline-source-context-and-append ()
  (josh/with-inline-agent
    (josh/inline-wait (lambda () (agent-shell-initialized-p :shell-buffer shell)))
    (let ((transient-mark-mode t))
      (goto-char (point-min))
      (set-mark (line-end-position))
      (activate-mark)
      (agent-shell-inline)
      (should (eq agent-shell-inline--reference-type 'region))
      (insert "explain this")
      (agent-shell-inline-append t)
      (should (string-empty-p (buffer-string)))
      (should-not agent-shell-inline--reference-type)
      (should (with-current-buffer shell (string-match-p "source line" (buffer-string))))
      (should (eq (agent-shell-status :shell-buffer shell) 'ready))
      (agent-shell-inline-send)
      (let ((overlay (agent-shell-inline--response-overlay-at-point)))
        (should overlay)
        (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get overlay 'agent-shell-inline-status))))
        (agent-shell-inline-copy-response)
        (should (string-match-p "explain this" (current-kill 0)))
        (should (string-match-p "source line" (current-kill 0)))))))

