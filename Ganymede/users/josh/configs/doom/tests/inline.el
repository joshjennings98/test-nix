(ert-deftest josh/inline-copy-and-scroll-full-response ()
  (josh/with-inline-agent
    (let* ((text (mapconcat #'number-to-string (number-sequence 1 30) "\n"))
           (overlay (agent-shell-inline-message text shell)))
      (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get overlay 'agent-shell-inline-status))))
      (agent-shell-inline--response-overlay-pagedown overlay)
      (should (> (overlay-get overlay 'agent-shell-inline-scroll-index) 0))
      (agent-shell-inline-copy-response)
      (should (string-match-p "30" (current-kill 0)))
      (agent-shell-inline-clear-response-overlay overlay)
      (should-not agent-shell-inline--response-overlay-mode))))
