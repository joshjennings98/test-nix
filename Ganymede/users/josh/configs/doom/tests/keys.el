(ert-deftest josh/inline-wheel-never-scrolls-document ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (insert "Source\n")
      (let ((overlay (agent-shell-inline--setup-response-overlay
                      (list :marker (point-marker) :buffer (current-buffer))))
            forwarded)
        (unwind-protect
            (cl-letf (((symbol-function 'agent-shell-inline--response-overlay-at-point)
                       (lambda () overlay))
                      ((symbol-function 'mwheel-scroll)
                       (lambda (event &optional _) (push event forwarded))))
              (agent-shell-inline--update-response-overlay "First\nSecond\nThird" overlay)
              (overlay-put overlay 'agent-shell-inline-height 2)
              (agent-shell-inline--response-overlay-render overlay)
              (dolist (events '((wheel-up wheel-down) (mouse-4 mouse-5)))
                (setq forwarded nil)
                (agent-shell-inline--response-overlay-scroll-to 0 overlay)
                (agent-shell-inline--response-overlay-wheel (car events))
                (should-not forwarded)
                (setq forwarded nil)
                (agent-shell-inline--response-overlay-wheel (cadr events))
                (should (= (overlay-get overlay 'agent-shell-inline-scroll-index) 1))
                (should-not forwarded)
                (agent-shell-inline--response-overlay-wheel (cadr events))
                (should-not forwarded)
                (setq forwarded nil)
                (agent-shell-inline--response-overlay-wheel (car events))
                (should (= (overlay-get overlay 'agent-shell-inline-scroll-index) 0))
                (should-not forwarded))
              (overlay-put overlay 'agent-shell-inline-height 16)
              (setq forwarded nil)
              (agent-shell-inline--response-overlay-wheel 'wheel-down)
              (should-not forwarded)
              (cl-letf (((symbol-function 'agent-shell-inline--response-overlay-at-point)
                         (lambda () nil)))
                (setq forwarded nil)
                (agent-shell-inline--response-overlay-wheel 'wheel-up)
                (should-not forwarded)))
          (agent-shell-inline-clear-response-overlay overlay))))))

(ert-deftest josh/inline-stalled-keyboard-movement-skips-preview ()
  (with-temp-buffer
    (insert "Before\nAnchor\nAfter\n")
    (goto-char (point-min))
    (forward-line 1)
    (let ((overlay (agent-shell-inline--setup-response-overlay
                    (list :marker (point-marker) :buffer (current-buffer))))
          (anchor (point))
          (line-move-visual t)
          calls)
      (unwind-protect
          (dolist (direction '(1 -1))
            (goto-char anchor)
            (setq calls nil)
            ;; Model visual motion consuming display lines without moving point.
            (agent-shell-inline--move-past-preview
             (lambda (count &rest args)
               (push (list count args line-move-visual) calls)
               (unless line-move-visual (forward-line count)))
             direction t)
            (should (= (line-number-at-pos) (if (> direction 0) 3 1)))
            (should (equal (nreverse calls)
                           (list (list direction '(t) t)
                                 (list direction '(t) nil))))
            (should (= (overlay-get overlay 'agent-shell-inline-scroll-index) 0)))
        (agent-shell-inline-clear-response-overlay overlay)))))

(ert-deftest josh/inline-keyboard-fallback-leaves-normal-motion-alone ()
  (with-temp-buffer
    (insert "Before\nAnchor\nAfter\n")
    (goto-char (point-min))
    (forward-line 1)
    (let ((overlay (agent-shell-inline--setup-response-overlay
                    (list :marker (point-marker) :buffer (current-buffer))))
          (calls 0))
      (unwind-protect
          (progn
            (should (eq (agent-shell-inline--move-past-preview
                         (lambda (count)
                           (cl-incf calls)
                           (forward-line count)
                           'moved)
                         1)
                        'moved))
            (should (= calls 1))
            ;; A stationary command away from the preview must not be retried.
            (agent-shell-inline--move-past-preview
             (lambda (_) (cl-incf calls)) 1)
            (should (= calls 2)))
        (agent-shell-inline-clear-response-overlay overlay)))))

(ert-deftest josh/inline-stalled-document-scroll-skips-preview ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (dotimes (i 100) (insert (format "Source line %d\n" i)))
      (goto-char (point-min))
      (forward-line 20)
      (let* ((window (selected-window))
             (overlay (agent-shell-inline--setup-response-overlay
                       (list :marker (point-marker) :buffer (current-buffer))))
             (anchor (overlay-start overlay))
             (text (buffer-string)))
        (unwind-protect
            (progn
              (agent-shell-inline--update-response-overlay
               (mapconcat #'number-to-string (number-sequence 1 30) "\n") overlay)
              (agent-shell-inline--response-overlay-render overlay)
              (set-window-start window anchor)
              (agent-shell-inline--scroll-document
               #'ignore (list 'wheel-down (list window (point-min) '(0 . 0) 0)))
              (should (> (window-start window) (overlay-end overlay)))
              (should (= (window-point window) (window-start window)))
              (agent-shell-inline--scroll-document
               #'ignore (list 'wheel-up (list window (point-min) '(0 . 0) 0)))
              (should (< (window-start window) anchor))
              (should (overlay-buffer overlay))
              (should (equal text (buffer-string))))
          (agent-shell-inline-clear-response-overlay overlay))))))

(ert-deftest josh/inline-document-scroll-leaves-progress-and-other-lines-alone ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (dotimes (i 100) (insert (format "Source line %d\n" i)))
      (goto-char (point-min))
      (forward-line 20)
      (let* ((window (selected-window))
             (overlay (agent-shell-inline--setup-response-overlay
                       (list :marker (point-marker) :buffer (current-buffer))))
             (anchor (overlay-start overlay))
             (event (list 'wheel-down (list window (point-min) '(0 . 0) 0)))
             called)
        (unwind-protect
            (progn
              (set-window-start window anchor)
              (should
               (eq (agent-shell-inline--scroll-document
                    (lambda (received &rest args)
                      (setq called t)
                      (should (eq received event))
                      (should (equal args '(2)))
                      (set-window-start window (1+ anchor))
                      'scrolled)
                    event 2)
                   'scrolled))
              (should called)
              (should (= (window-start window) (1+ anchor)))
              (set-window-start window (point-min))
              (agent-shell-inline--scroll-document #'ignore event)
              (should (= (window-start window) (point-min)))
              (set-window-start window anchor)
              (agent-shell-inline--scroll-document
               #'ignore (list 'wheel-left (cadr event)))
              (should (= (window-start window) anchor))
              (agent-shell-inline-clear-response-overlay overlay)
              (agent-shell-inline--scroll-document #'ignore event)
              (should (= (window-start window) anchor)))
          (agent-shell-inline-clear-response-overlay overlay))))))

