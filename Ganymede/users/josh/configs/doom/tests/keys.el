(ert-deftest josh/agent-shell-review-buttons ()
  (with-temp-buffer
    (agent-shell-mode)
    (switch-to-buffer (current-buffer))
    (let ((actions nil)
          (allow-map (make-sparse-keymap))
          (reject-map (make-sparse-keymap)))
      (define-key allow-map (kbd "RET") (lambda () (interactive) (push 'allow actions)))
      (define-key reject-map (kbd "RET") (lambda () (interactive) (push 'reject actions)))
      (insert (propertize "Allow" 'keymap allow-map 'agent-shell-permission-button t)
              "\n"
              (propertize "Reject" 'keymap reject-map 'agent-shell-permission-button t))
      (goto-char (point-min))
      (evil-normal-state)
      (should (eq (key-binding (kbd "y")) 'evil-yank))
      (should (eq (key-binding (kbd "v")) 'evil-visual-char))
      (execute-kbd-macro (kbd "RET"))
      (should (equal actions '(allow)))
      (goto-char (point-max))
      (backward-char)
      (execute-kbd-macro (kbd "RET"))
      (should (equal actions '(reject allow))))))

