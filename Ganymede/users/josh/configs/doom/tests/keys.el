;;; keys.el --- Offline Agent Shell interaction checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'agent-shell)

(ert-deftest josh/inline-temporary-navigation ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (insert "first source line\nsecond source line\nthird source line\n")
      (goto-char (point-min))
      (evil-normal-state)
      (let ((overlay (agent-shell-inline--setup-response-overlay
                      (list :marker (point-marker) :buffer (current-buffer)))))
        (unwind-protect
            (progn
              (agent-shell-inline--update-response-overlay
               (mapconcat #'number-to-string (number-sequence 1 30) "\n") overlay)
              (agent-shell-inline--response-overlay-render overlay)
              (should (eq (key-binding (kbd "j")) 'evil-next-line))
              (execute-kbd-macro (kbd "SPC a e n j j k"))
              (should (= (point) (point-min)))
              (should (= (overlay-get overlay 'agent-shell-inline-scroll-index) 1))
              (let (moves)
                (cl-letf (((symbol-function 'agent-shell-inline-previous-message)
                           (lambda (target) (should (eq target overlay)) (push 'previous moves)))
                          ((symbol-function 'agent-shell-inline-next-message)
                           (lambda (target) (should (eq target overlay)) (push 'next moves))))
                  (execute-kbd-macro (kbd "K J")))
                (should (equal (nreverse moves) '(previous next))))
              (execute-kbd-macro (kbd "q j"))
              (should (= (line-number-at-pos) 2))
              (should-not (overlay-get overlay 'agent-shell-inline-navigation-exit))
              (execute-kbd-macro (kbd "SPC a e n j <escape>"))
              (should (eq (key-binding (kbd "j")) 'evil-next-line))
              (execute-kbd-macro (kbd "SPC a e n i j"))
              (should (evil-insert-state-p))
              (should (= (char-before) ?j))
              (evil-normal-state)
              (execute-kbd-macro (kbd "SPC a e n"))
              (agent-shell-inline-clear-response-overlay overlay)
              (should (eq (key-binding (kbd "j")) 'evil-next-line))
              (should-not (command-remapping 'enlarge-window nil
                                             (list agent-shell-inline--response-overlay-mode-map)))
              (should-not (command-remapping 'scroll-other-window nil
                                             (list agent-shell-inline--response-overlay-mode-map))))
          (agent-shell-inline-clear-response-overlay overlay))))))

(ert-deftest josh/inline-doom-control-hints ()
  (save-window-excursion
    (let ((source (generate-new-buffer " *inline-panel-source*"))
          (shell (generate-new-buffer " *inline-panel-shell*"))
          prompt)
      (unwind-protect
          (progn
            (with-current-buffer shell (agent-shell-mode))
            (switch-to-buffer source)
            (insert "Source for the inline prompt\n")
            (setq prompt (agent-shell-inline nil shell))
            (evil-normal-state)
            (dolist (entry agent-shell-inline-key-bindings)
              (should (eq (key-binding (kbd (cdr entry))) (car entry))))
            (let ((header (agent-shell-inline--prompt-header)))
              (should (string-match-p (regexp-quote (buffer-name shell)) header))
              (should (text-property-any 0 (length header) 'face 'help-key-binding header))
              (should-not (string-match-p "C-c" header)))
            (let ((overlay (make-overlay (point-min) (point-max))))
              (unwind-protect
                  (let ((header (agent-shell-inline--response-overlay-header overlay)))
                    (should (string-match-p "SPC a e o" header))
                    (should (text-property-any 0 (length header) 'face 'help-key-binding header))
                    (should-not (string-match-p "C-c" header)))
                (delete-overlay overlay)))
            (let ((window (selected-window)))
              (execute-kbd-macro (kbd "SPC m h"))
              (should (eq (selected-window) window))
              (let* ((help agent-shell-inline--help-buffer)
                     (help-window (get-buffer-window help)))
                (should (window-live-p help-window))
                (should (< (nth 1 (window-edges help-window)) (nth 1 (window-edges window))))
                (with-current-buffer help
                  (should (text-property-not-all (point-min) (point-max) 'vtable nil))
                  (should (string-match-p "SPC m s" (buffer-string)))
                  (should (string-match-p "SPC a e o" (buffer-string)))
                  (should-not (string-match-p "C-c" (buffer-string))))
                (execute-kbd-macro (kbd "SPC m h"))
                (should-not (buffer-live-p help)))
              (execute-kbd-macro (kbd "SPC m h"))
              (let ((help agent-shell-inline--help-buffer))
                (agent-shell-inline-quit)
                (should-not (buffer-live-p help))
                (should-not (buffer-live-p prompt)))))
        (dolist (buffer (list prompt source shell))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest josh/inline-response-action-presentation ()
  (with-temp-buffer
    (insert "Source\n")
    (let ((overlay (agent-shell-inline--setup-response-overlay
                    (list :marker (point-marker) :buffer (current-buffer)))))
      (unwind-protect
          (progn
            (cl-letf (((symbol-function 'read-multiple-choice)
                       (lambda (_prompt choices &rest _args)
                         (let ((rendered (overlay-get overlay 'after-string)))
                           (should (string-match-p "y copy" rendered))
                           (should (text-property-any 0 (length rendered) 'face 'help-key-binding rendered)))
                         (assq ?q choices))))
              (agent-shell-inline--response-overlay-dispatch overlay))
            (should-not (overlay-get overlay 'agent-shell-inline-header))
            (should (string-match-p "SPC a e o" (overlay-get overlay 'after-string)))
            (agent-shell-inline--response-overlay-resize overlay 3)
            (agent-shell-inline--response-overlay-resize overlay 'reset)
            (should (= (overlay-get overlay 'agent-shell-inline-height)
                       (agent-shell-inline--response-overlay-height))))
        (agent-shell-inline-clear-response-overlay overlay)))))

(ert-deftest josh/inline-dictionary-completion ()
  (require 'ispell)
  (with-temp-buffer
    (agent-shell-inline-prompt-mode)
    (insert "dictio")
    (should (equal ispell-dictionary "en_GB"))
    (should (executable-find ispell-program-name))
    (pcase-let ((`(,_ ,_ ,table . ,_) (ispell-completion-at-point)))
      (should (member "dictionary" (all-completions "dictio" table))))))

(ert-deftest josh/inline-doom-prompt ()
  (let ((shell (generate-new-buffer " *inline-key-shell*"))
        (source (generate-new-buffer " *inline-key-source*"))
        prompt)
    (save-window-excursion
      (unwind-protect
          (progn
            (with-current-buffer shell (agent-shell-mode))
            (switch-to-buffer source)
            (insert "selected source\n")
            (goto-char (point-min))
            (setq-local agent-shell-inline--last shell)
            (evil-normal-state)
            (execute-kbd-macro (kbd "v $ SPC a p"))
            (setq prompt (current-buffer))
            (should visual-line-mode)
            (should-not truncate-lines)
            (should (eq agent-shell-inline--reference-type 'region))
            (should-not (get-buffer-window shell))
            (evil-insert-state)
            (execute-kbd-macro (kbd "n p r + - 0 RET"))
            (should (equal (buffer-string) "npr+-0\n"))
            (should (eq (key-binding (kbd "C-c RET")) 'agent-shell-inline-send))
            (evil-normal-state)
            (should (eq (key-binding (kbd "RET")) 'agent-shell-inline-send))
            (should (eq (key-binding (kbd "SPC m s")) 'agent-shell-inline-send))
            (should (eq (key-binding (kbd "SPC a p")) 'agent-shell-inline))
            (should (eq (key-binding (kbd "SPC a m")) 'agent-shell-inline-message))
            (should (eq (key-binding (kbd "SPC a e j")) 'agent-shell-inline--response-overlay-down))
            (should-not (lookup-key agent-shell-inline-map (kbd "M-RET")))
            (should-not (lookup-key agent-shell-inline--response-overlay-mode-map (kbd "M-RET")))
            (agent-shell-inline-cycle-reference)
            (should (eq agent-shell-inline--reference-type 'none))
            (agent-shell-inline-quit)
            (should-not (buffer-live-p prompt))
            (should (buffer-live-p shell)))
        (dolist (buffer (list prompt source shell))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest josh/agent-shell-command-bindings ()
  (should-not (featurep 'evil-collection-agent-shell))
  (dolist (map (list agent-shell-mode-map agent-shell-viewport-edit-mode-map
                     agent-shell-viewport-view-mode-map agent-shell-diff-mode-map
                     agent-shell-artist-mode-map))
    (dolist (state '(normal insert))
      (when-let* ((bindings (evil-get-auxiliary-keymap map state)))
        (map-keymap
         (lambda (_event binding)
           (when (and (symbolp binding)
                      (string-match-p "\\`\\(?:josh/\\)?agent-shell-"
                                      (symbol-name binding)))
             (should (commandp binding))))
         bindings)))))

(ert-deftest josh/agent-shell-viewport-editing ()
  ;; Rendering a header needs a live session; editing and keymaps do not.
  (cl-letf (((symbol-function 'agent-shell-viewport--update-header) #'ignore))
    (with-temp-buffer
      (agent-shell-viewport-edit-mode)
      (setq-local agent-shell-viewport--clean-up nil)
      (switch-to-buffer (current-buffer))
      (evil-insert-state)
      (execute-kbd-macro (kbd "- SPC i t e m RET"))
      (should (equal (buffer-string) "- item\n- "))
      (evil-normal-state)
      (should (eq (key-binding (kbd "SPC m s")) 'agent-shell-viewport-compose-send))
      (should (eq (key-binding (kbd "SPC m k")) 'agent-shell-viewport-compose-cancel))
      (should (eq (key-binding (kbd "SPC m H s")) 'agent-shell-viewport-search-history))
      (agent-shell-viewport-view-mode)
      (setq-local agent-shell-viewport--clean-up nil)
      (evil-normal-state)
      (should (eq (key-binding (kbd "j")) 'evil-next-line))
      (should (eq (key-binding (kbd "y")) 'evil-yank))
      (should (eq (key-binding (kbd "v")) 'evil-visual-char))
      (should (eq (key-binding (kbd "] p")) 'agent-shell-viewport-next-page))
      (should (eq (key-binding (kbd "SPC m m t")) 'agent-shell-viewport-set-session-thought-level))
      (should (eq (key-binding (kbd "SPC m r")) 'agent-shell-viewport-reply)))))

(ert-deftest josh/agent-shell-edit-and-navigate ()
  (with-temp-buffer
    (agent-shell-mode)
    (switch-to-buffer (current-buffer))
    (evil-insert-state)
    (execute-kbd-macro (kbd "n p r + - 0 RET"))
    (should (equal (buffer-string) "npr+-0\n"))
    (evil-normal-state)
    (should (eq (key-binding (kbd "j")) 'evil-next-line))
    (should (eq (key-binding (kbd "v")) 'evil-visual-char))
    (should (eq (key-binding (kbd "y")) 'evil-yank))
    (should (eq (key-binding (kbd "] ]")) 'agent-shell-next-item))
    (should (eq (key-binding (kbd "SPC m m v")) 'agent-shell-set-session-model))
    (should (eq (key-binding (kbd "SPC m q q")) 'agent-shell-prompt-queue))
    (should (eq (key-binding (kbd "C-c RET")) 'agent-shell-submit))))

(ert-deftest josh/agent-shell-review-buttons ()
  (with-temp-buffer
    (agent-shell-mode)
    (switch-to-buffer (current-buffer))
    (let ((actions nil)
          (allow-map (make-sparse-keymap))
          (reject-map (make-sparse-keymap)))
      (define-key allow-map (kbd "RET") (lambda () (interactive) (push 'allow actions)))
      (define-key reject-map (kbd "RET") (lambda () (interactive) (push 'reject actions)))
      (insert (propertize "Allow" 'keymap allow-map 'agent-shell-permission-button t)
              "\n"
              (propertize "Reject" 'keymap reject-map 'agent-shell-permission-button t))
      (goto-char (point-min))
      (evil-normal-state)
      (should (eq (key-binding (kbd "y")) 'evil-yank))
      (should (eq (key-binding (kbd "v")) 'evil-visual-char))
      (execute-kbd-macro (kbd "RET"))
      (should (equal actions '(allow)))
      (goto-char (point-max))
      (backward-char)
      (execute-kbd-macro (kbd "RET"))
      (should (equal actions '(reject allow))))))

(ert-deftest josh/agent-shell-diff-review ()
  (let ((accepted nil)
        (buffer (generate-new-buffer " *agent-review-test*")))
    (unwind-protect
        (with-current-buffer buffer
          (agent-shell-diff-mode)
          (switch-to-buffer buffer)
          (setq-local agent-shell-diff--accept-all-command
                      (lambda () (setq accepted t)))
          (evil-normal-state)
          (should (eq (key-binding (kbd "y")) 'evil-yank))
          (should (eq (key-binding (kbd "] c")) 'diff-hunk-next))
          (should (eq (key-binding (kbd "SPC m r")) 'agent-shell-diff-reject-all))
          (execute-kbd-macro (kbd "SPC m a"))
          (should accepted)
          (should-not (buffer-live-p buffer)))
      (when (buffer-live-p buffer)
        (kill-buffer buffer)))))

(ert-deftest josh/agent-shell-command-picker ()
  (let (chosen)
    (cl-letf (((symbol-function 'completing-read)
               (lambda (_prompt collection predicate &rest _)
                 (should (eq collection obarray))
                 (should (funcall predicate 'agent-shell-elicitation-act))
                 (should (funcall predicate 'agent-shell-viewport-reply-9))
                 (should-not (funcall predicate 'agent-shell--start))
                 "agent-shell-version"))
              ((symbol-function 'agent-shell-version)
               (lambda () (interactive) (setq chosen t))))
      (josh/agent-shell-command)
      (should chosen))))
