(defun josh/inline-click-hint (overlay label)
  "Run the mouse action on OVERLAY's rendered LABEL."
  (let* ((text (overlay-get overlay 'after-string))
         (position (string-match (regexp-quote label) text)))
    (should position)
    (let ((map (get-text-property position 'keymap text)))
      (should (eq (lookup-key map [down-mouse-1]) #'ignore))
      (let ((command (lookup-key map [mouse-1])))
        (should (commandp command))
        (call-interactively command)))))

(ert-deftest josh/inline-clickable-navigation ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (insert "Source\nElsewhere\n")
      (goto-char (point-min))
      (evil-normal-state)
      (let ((overlay (agent-shell-inline--setup-response-overlay
                      (list :marker (point-marker) :buffer (current-buffer)))))
        (unwind-protect
            (progn
              (agent-shell-inline--update-response-overlay
               (mapconcat #'number-to-string (number-sequence 1 100) "\n") overlay)
              (agent-shell-inline--response-overlay-render overlay)
              (goto-char (point-max))
              (let ((position (point)))
                (josh/inline-click-hint overlay "↓")
                (should (= (overlay-get overlay 'agent-shell-inline-scroll-index) 1))
                (josh/inline-click-hint overlay "↑")
                (should (= (overlay-get overlay 'agent-shell-inline-scroll-index) 0))
                (josh/inline-click-hint overlay "navigate:")
                (josh/inline-click-hint overlay "j down")
                (josh/inline-click-hint overlay "j down")
                (josh/inline-click-hint overlay "k up")
                (should (= (overlay-get overlay 'agent-shell-inline-scroll-index) 1))
                (josh/inline-click-hint overlay "C-d page down")
                (should (> (overlay-get overlay 'agent-shell-inline-scroll-index) 1))
                (josh/inline-click-hint overlay "C-u page up")
                (should (= (overlay-get overlay 'agent-shell-inline-scroll-index) 1))
                (cl-letf (((symbol-function 'agent-shell-inline-next-message)
                           (lambda (target) (should (eq target overlay))))
                          ((symbol-function 'agent-shell-inline-previous-message)
                           (lambda (target) (should (eq target overlay))))
                          ((symbol-function 'agent-shell-inline--show-live)
                           (lambda (target) (should (eq target overlay)))))
                  (josh/inline-click-hint overlay "J newer")
                  (josh/inline-click-hint overlay "K older")
                  (josh/inline-click-hint overlay "g live"))
                (josh/inline-click-hint overlay "Esc/q exit")
                (should-not (overlay-get overlay 'agent-shell-inline-navigation-exit))
                (should (= (point) position))))
          (agent-shell-inline-clear-response-overlay overlay))))))

(ert-deftest josh/inline-clicked-preview-actions ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (insert "Source\n")
      (let ((overlay (agent-shell-inline--setup-response-overlay
                      (list :marker (point-marker) :buffer (current-buffer)))))
        (unwind-protect
            (cl-letf (((symbol-function 'agent-shell-inline--response-overlay-at-point)
                       (lambda () (ert-fail "Click must use its own preview"))))
              (cl-letf (((symbol-function 'agent-shell-inline)
                         (lambda (target) (should (eq target overlay)))))
