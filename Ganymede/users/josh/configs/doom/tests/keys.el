(ert-deftest josh/inline-temporary-navigation ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (insert "first source line\nsecond source line\nthird source line\n")
      (goto-char (point-min))
      (evil-normal-state)
      (let ((overlay (agent-shell-inline--setup-response-overlay
                      (list :marker (point-marker) :buffer (current-buffer)))))
        (unwind-protect
            (progn
              (agent-shell-inline--update-response-overlay
               (mapconcat #'number-to-string (number-sequence 1 30) "\n") overlay)
              (agent-shell-inline--response-overlay-render overlay)
              (should (eq (key-binding (kbd "j")) 'evil-next-line))
              (execute-kbd-macro (kbd "SPC a n j j k"))
              (should (= (point) (point-min)))
              (should (= (overlay-get overlay 'agent-shell-inline-scroll-index) 1))
              (let (moves)
                (cl-letf (((symbol-function 'agent-shell-inline-previous-message)
                           (lambda (target) (should (eq target overlay)) (push 'previous moves)))
                          ((symbol-function 'agent-shell-inline-next-message)
                           (lambda (target) (should (eq target overlay)) (push 'next moves))))
                  (execute-kbd-macro (kbd "K J")))
                (should (equal (nreverse moves) '(previous next))))
              (execute-kbd-macro (kbd "q j"))
              (should (= (line-number-at-pos) 2))
              (should-not (overlay-get overlay 'agent-shell-inline-navigation-exit))
              (execute-kbd-macro (kbd "SPC a n j <escape>"))
              (should (eq (key-binding (kbd "j")) 'evil-next-line))
              (execute-kbd-macro (kbd "SPC a n i j"))
              (should (evil-insert-state-p))
              (should (= (char-before) ?j))
              (evil-normal-state)
              (execute-kbd-macro (kbd "SPC a n"))
              (agent-shell-inline-clear-response-overlay overlay)
              (should (eq (key-binding (kbd "j")) 'evil-next-line))
              (should-not (command-remapping 'enlarge-window nil
                                             (list agent-shell-inline--response-overlay-mode-map)))
              (should-not (command-remapping 'scroll-other-window nil
                                             (list agent-shell-inline--response-overlay-mode-map))))
          (agent-shell-inline-clear-response-overlay overlay))))))

(ert-deftest josh/inline-doom-control-hints ()
  (save-window-excursion
    (let ((source (generate-new-buffer " *inline-panel-source*"))
          (shell (generate-new-buffer " *inline-panel-shell*"))
          prompt)
      (unwind-protect
          (progn
            (with-current-buffer shell (agent-shell-mode))
            (switch-to-buffer source)
            (insert "Source for the inline prompt\n")
            (setq prompt (agent-shell-inline nil shell))
            (evil-normal-state)
            (dolist (entry agent-shell-inline-key-bindings)
              (pcase (cdr entry)
                (":wq" (should (eq (evil-ex-binding "wq") #'agent-shell-inline-write-and-quit)))
                (":q" (should (eq (evil-ex-binding "q") #'agent-shell-inline-quit)))
                (_ (should (eq (key-binding (kbd (cdr entry))) (car entry))))))
            (let ((header (agent-shell-inline--prompt-header)))
              (should (string-match-p (regexp-quote (buffer-name shell)) header))
              (should (string-match-p "Send: :wq" header))
              (should (string-match-p "Cancel: :q" header))
              (should-not (string-match-p "SPC m s" header))
              (should (text-property-any 0 (length header) 'face 'help-key-binding header))
              (should-not (string-match-p "C-c" header)))
            (let ((overlay (make-overlay (point-min) (point-max))))
              (unwind-protect
                  (let ((header (agent-shell-inline--response-overlay-header overlay)))
                    (should (string-match-p "SPC a o" header))
                    (should (string-match-p "reply: SPC a r" header))
                    (should (text-property-any 0 (length header) 'face 'help-key-binding header))
                    (should-not (string-match-p "C-c" header)))
                (delete-overlay overlay)))
            (let ((window (selected-window)))
              (execute-kbd-macro (kbd "SPC m h"))
              (should (eq (selected-window) window))
              (let* ((help agent-shell-inline--help-buffer)
                     (help-window (get-buffer-window help)))
                (should (window-live-p help-window))
                (should (< (nth 1 (window-edges help-window)) (nth 1 (window-edges window))))
                (with-current-buffer help
                  (should (text-property-not-all (point-min) (point-max) 'vtable nil))
                  (should (string-match-p ":wq" (buffer-string)))
                  (should (string-match-p "SPC a r" (buffer-string)))
                  (should-not (string-match-p "SPC m s" (buffer-string)))
                  (should (string-match-p "SPC a o" (buffer-string)))
                  (should-not (string-match-p "C-c" (buffer-string))))
                (execute-kbd-macro (kbd "SPC m h"))
                (should-not (buffer-live-p help)))
              (execute-kbd-macro (kbd "SPC m h"))
              (let ((help agent-shell-inline--help-buffer))
                (agent-shell-inline-quit)
                (should-not (buffer-live-p help))
                (should-not (buffer-live-p prompt)))))
        (dolist (buffer (list prompt source shell))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest josh/inline-response-action-presentation ()
  (with-temp-buffer
    (insert "Source\n")
    (let ((overlay (agent-shell-inline--setup-response-overlay
                    (list :marker (point-marker) :buffer (current-buffer)))))
      (unwind-protect
          (progn
            (agent-shell-inline--response-overlay-dispatch overlay)
            (let ((rendered (overlay-get overlay 'after-string)))
              (should (string-match-p "y copy" rendered))
              (should (text-property-any 0 (length rendered) 'face 'help-key-binding rendered)))
            (let ((height (overlay-get overlay 'agent-shell-inline-height)))
              (josh/inline-click-hint overlay "+ +height")
              (should (= (overlay-get overlay 'agent-shell-inline-height) (+ height 3)))
              (josh/inline-click-hint overlay "- -height")
              (should (= (overlay-get overlay 'agent-shell-inline-height) height)))
            (josh/inline-click-hint overlay "q quit")
            (should-not (overlay-get overlay 'agent-shell-inline-header))
            (should (string-match-p "SPC a o" (overlay-get overlay 'after-string)))
            (agent-shell-inline--response-overlay-resize overlay 3)
            (agent-shell-inline--response-overlay-resize overlay 'reset)
            (should (= (overlay-get overlay 'agent-shell-inline-height)
                       (agent-shell-inline--response-overlay-height))))
        (agent-shell-inline-clear-response-overlay overlay)))))

