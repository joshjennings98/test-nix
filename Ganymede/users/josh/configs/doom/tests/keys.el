;;; keys.el --- Offline interactive Doom checks -*- lexical-binding: t; -*-
;; Run with a fresh HOME: emacs -nw --load this-file. No model requests are sent.
(require 'ert)

(ert-deftest josh/keys-complete-prompt-and-rewrite-maps ()
  (switch-to-buffer (get-buffer-create "*key-test-coverage*"))
  (evil-normal-state)
  ;; Every keyboard action in these source maps must have a documented route.
  (dolist (spec `((,gptel-inline-map
                   (gptel-inline-send . "s")
                   (gptel-inline-cycle-reference . "c")
                   (gptel-inline-append . "a")
                   (gptel-inline-quit . "q")
                   (gptel-inline-switch-buffer . "b")
                   (gptel-inline-visit-buffer . "v")
                   (gptel-inline-help . "h"))
                  (,gptel-rewrite-actions-map
                   (gptel--rewrite-dispatch . "R o")
                   (gptel--rewrite-accept . "R a")
                   (gptel--rewrite-iterate . "R r")
                   (gptel--rewrite-reject . "R q")
                   (gptel--rewrite-diff . "R d")
                   (gptel--rewrite-ediff . "R e")
                   (gptel--rewrite-next . "R j")
                   (gptel--rewrite-previous . "R k")
                   (gptel--rewrite-merge . "R m"))))
    (let ((checked 0))
      (dolist (entry (accessible-keymaps (car spec)))
        (map-keymap
         (lambda (_event command)
           (when (commandp command)
             (cl-incf checked)
             (let ((route (cdr (assq command (cdr spec)))))
               (should route)
               (should (commandp (key-binding (kbd (concat "SPC a " route))))))))
         (cdr entry)))
      (should (>= checked (length (cdr spec)))))))

(ert-deftest josh/keys-inline-context-and-append ()
  (switch-to-buffer (get-buffer-create "*key-test-append*"))
  (erase-buffer)
  (insert "selected reference\n")
  (goto-char (point-min))
  (evil-normal-state)
  (execute-kbd-macro (kbd "V SPC a p"))
  (let ((chat (buffer-base-buffer)))
    (should (eq gptel-inline--reference-type 'region))
    (evil-normal-state)
    (execute-kbd-macro (kbd "SPC a c"))
    (should (eq gptel-inline--reference-type 'none))
    (insert "Append this without sending")
    (execute-kbd-macro (kbd "SPC a a"))
    (should (buffer-live-p chat))
    (with-current-buffer chat
      (should (string-match-p "Append this without sending" (buffer-string))))))

(ert-deftest josh/keys-contextual-actions ()
  ;; Use the real maps; spy only on execution so no tool or request is run.
  (dolist (map (list gptel-tool-call-actions-map gptel-tool-call-inspection-map
                    gptel-context-buffer-mode-map))
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (use-local-map map)
      (evil-normal-state)
      (dolist (pair '(("RET" . "C-c C-c") ("q" . "C-c C-k")))
        (let ((command (key-binding (kbd (cdr pair)))) invoked)
          (cl-letf (((symbol-function command)
                     (lambda () (interactive) (setq invoked t))))
            (execute-kbd-macro (kbd (concat "SPC a " (car pair))))
            (should invoked))))))
  (with-temp-buffer
    (use-local-map (make-sparse-keymap))
    (local-set-key (kbd "C-c C-c") #'ignore)
    (should-error (josh/gptel-local-action "C-c C-c") :type 'user-error)))

(ert-deftest josh/keys-switch-help-and-cancel ()
  (let ((target (gptel "*key-test-switch-target*")))
    (switch-to-buffer (get-buffer-create "*key-test-switch-source*"))
    (erase-buffer)
    (insert "source\n")
    (goto-char (point-min))
    (evil-normal-state)
    (execute-kbd-macro (kbd "SPC a p"))
    (insert "unsent prompt")
    (evil-normal-state)
    (cl-letf (((symbol-function 'read-buffer)
               (lambda (&rest _) (buffer-name target))))
      (execute-kbd-macro (kbd "SPC a b")))
    (should (eq (buffer-base-buffer) target))
    (should (string-match-p "unsent prompt" (buffer-string)))
    (evil-normal-state)
    (execute-kbd-macro (kbd "SPC a h"))
    (should (get-buffer-window "*gptel-inline-help*"))
    (execute-kbd-macro (kbd "SPC a q"))
    (with-current-buffer target
      (should-not (string-match-p "unsent prompt" (buffer-string))))))

(ert-deftest josh/keys-instruction-editor ()
  (switch-to-buffer (get-buffer-create "*key-test-instructions*"))
  (let ((gptel-system-prompt "before") result)
    (gptel--edit-directive 'gptel-system-prompt
      :initial "after" :callback (lambda (text) (setq result text)))
    (evil-normal-state)
    (execute-kbd-macro (kbd "SPC a RET"))
    (should (equal result "after"))
    (gptel--edit-directive 'gptel-system-prompt
      :initial "cancelled" :callback (lambda (text) (setq result text)))
    (evil-normal-state)
    (execute-kbd-macro (kbd "SPC a q"))
    (should-not result)))

(ert-deftest josh/keys-rewrite-accept-and-reject ()
  (switch-to-buffer (get-buffer-create "*key-test-rewrite*"))
  (erase-buffer)
  (insert "old text\n")
  (goto-char (point-min))
  (evil-normal-state)
  (let ((overlay (make-overlay (point-min) (1- (point-max)))))
    (overlay-put overlay 'gptel-rewrite "replacement")
    (overlay-put overlay 'keymap gptel-rewrite-actions-map)
    (setq-local gptel--rewrite-overlays (list overlay))
    (execute-kbd-macro (kbd "SPC a R a"))
    (should (equal (buffer-string) "replacement\n")))
  (goto-char (point-min))
  (let ((overlay (make-overlay (point-min) (1- (point-max)))))
    (overlay-put overlay 'gptel-rewrite "must not be inserted")
    (setq-local gptel--rewrite-overlays (list overlay))
    (execute-kbd-macro (kbd "SPC a R q"))
    (should-not (overlay-buffer overlay))
    (should (equal (buffer-string) "replacement\n"))))

(ert-deftest josh/keys-selection ()
  (switch-to-buffer (get-buffer-create "*key-test-source*"))
  (erase-buffer)
  (emacs-lisp-mode)
  (insert "abcdef\nsecond line\n")
  (goto-char (point-min))
  (evil-normal-state)
  (execute-kbd-macro (kbd "v l l SPC a p"))
  (let ((reference (plist-get gptel-inline--context :reference-ov)))
    (should (overlayp reference))
    (should (equal (with-current-buffer (overlay-buffer reference)
                     (buffer-substring-no-properties
                      (overlay-start reference) (overlay-end reference)))
                   "abc")))
  (evil-normal-state)
  (should (eq (key-binding (kbd "SPC a s")) 'gptel-inline-send))
  (gptel-inline-quit))

(ert-deftest josh/keys-line-selection ()
  (switch-to-buffer (get-buffer-create "*key-test-lines*"))
  (erase-buffer)
  (insert "first line\nsecond line\nthird line\n")
  (goto-char (point-min))
  (evil-normal-state)
  (execute-kbd-macro (kbd "V j SPC a p"))
  (let ((reference (plist-get gptel-inline--context :reference-ov)))
    (should (equal (with-current-buffer (overlay-buffer reference)
                     (buffer-substring-no-properties
                      (overlay-start reference) (overlay-end reference)))
                   "first line\nsecond line\n")))
  (gptel-inline-quit))

(ert-deftest josh/keys-preview-and-conversation ()
  (let ((chat (gptel "*key-test-chat*")))
    (switch-to-buffer (get-buffer-create "*key-test-code*"))
    (erase-buffer)
    (insert "source line\n")
    (goto-char (point-min))
    (evil-normal-state)
    (let ((overlay (gptel-inline--setup-response-overlay
                    (list :marker (point-marker) :buffer chat))))
      (should (equal (substring-no-properties (overlay-get overlay 'gptel-inline-header))
                     "SPC a: j/k line, J/K page, o actions, v chat"))
      (gptel-inline--update-response-overlay
       (mapconcat (lambda (n) (format "Response %d" n)) (number-sequence 1 50) "\n")
       overlay)
      (execute-kbd-macro (kbd "SPC a j"))
      (should (= (overlay-get overlay 'gptel-inline-scroll-index) 1))
      (should (= (point) (point-min)))
      (execute-kbd-macro (kbd "SPC a J"))
      (should (= (overlay-get overlay 'gptel-inline-scroll-index)
                 (1+ (overlay-get overlay 'gptel-inline-height))))
      (execute-kbd-macro (kbd "SPC a K SPC a k"))
      (should (= (overlay-get overlay 'gptel-inline-scroll-index) 0))
      (should (eq (key-binding (kbd "j")) 'evil-next-line))
      (execute-kbd-macro (kbd "SPC a v"))
      (should (eq (current-buffer) chat))
      (should (evil-normal-state-p))
      (erase-buffer)
      (insert "select this response\n")
      (goto-char (point-min))
      (execute-kbd-macro (kbd "v l l l l l y"))
      (should (equal (current-kill 0) "select")))))

(ert-deftest josh/keys-tool-preview ()
  (switch-to-buffer (get-buffer-create "*key-test-tools*"))
  (erase-buffer)
  (insert "Tool one\nbody\nTool two\nbody\n")
  (evil-normal-state)
  (let* ((boundary (save-excursion (goto-char (point-min)) (forward-line 2) (point)))
         (first (gptel-agent--confirm-overlay (point-min) boundary t))
         (second (gptel-agent--confirm-overlay boundary (point-max) t)))
    (overlay-put first 'gptel-tool t)
    (overlay-put second 'gptel-tool t)
    (goto-char (point-min))
    (should (eq (key-binding (kbd "C-c C-c")) 'gptel--accept-tool-calls))
    (should (eq (key-binding (kbd "C-c C-k")) 'gptel--reject-tool-calls))
    (execute-kbd-macro (kbd "j"))
    (should (= (point) boundary))
    (execute-kbd-macro (kbd "k"))
    (should (= (point) (point-min)))
    (evil-insert-state)
    (should (eq (key-binding (kbd "j")) 'self-insert-command))
    (evil-normal-state)))

(ert-deftest josh/keys-context-and-menu ()
  (switch-to-buffer (get-buffer-create "*key-test-context*"))
  (gptel-context-buffer-mode)
  (should (evil-normal-state-p))
  (should (eq (key-binding (kbd "j")) 'gptel-context-next))
  (should (eq (key-binding (kbd "k")) 'gptel-context-previous))
  (should (eq (key-binding (kbd "C-c C-c")) 'gptel-context-confirm))
  (should (eq (key-binding (kbd "C-c C-k")) 'gptel-context-quit))
  (should-not (equal (lookup-key key-translation-map (kbd "C-c m")) (kbd "ESC")))
  (should (equal (plist-get (cdr (transient-get-suffix 'gptel-menu "C-c RET")) :command)
                 'gptel--regenerate)))

(run-at-time
 1 nil
 (lambda ()
   (condition-case err
       (progn
         (require 'gptel-inline)
         (require 'gptel-agent)
         (require 'gptel-context)
         (require 'gptel-transient)
         (require 'gptel-rewrite)
         (advice-add 'gptel-request :override
                     (lambda (&rest _) (error "Model requests are forbidden in keyboard tests")))
         (let ((stats (ert-run-tests-batch "^josh/keys-")))
           (with-temp-file (getenv "DOOM_KEYS_RESULT")
             (insert (with-current-buffer "*Messages*" (buffer-string))))
           (kill-emacs (if (zerop (ert-stats-completed-unexpected stats)) 0 1))))
     (error
      (with-temp-file (getenv "DOOM_KEYS_RESULT") (prin1 err (current-buffer)))
      (kill-emacs 2)))))
