;;; keys.el --- Offline Agent Shell interaction checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'agent-shell)

(ert-deftest josh/agent-suite-shortcuts ()
  (with-temp-buffer
    (evil-normal-state)
    (dolist (entry '(("a j" . agent-shell-inline--response-overlay-down)
                     ("a k" . agent-shell-inline--response-overlay-up)
                     ("a D" . agent-shell-inline--response-overlay-pagedown)
                     ("a U" . agent-shell-inline--response-overlay-pageup)
                     ("a n" . agent-shell-inline-navigate)
                     ("a o" . agent-shell-inline--response-overlay-dispatch)
                     ("a v" . agent-shell-inline-review)
                     ("a x" . agent-shell-inline-interrupt)
                     ("a a" . agent-shell)
                     ("a b" . agent-shell-switch-buffer)
                     ("a N n" . agent-shell-new-shell)
                     ("a N r" . agent-shell-resume-session)
                     ("a N w" . agent-shell-new-worktree-shell)
                     ("a r" . agent-shell-inline-reply)
                     ("a p" . agent-shell-inline)
                     ("a P" . agent-shell-inline-visit)
                     ("a m" . agent-shell-inline-message)
                     ("a t" . agent-shell-toggle)
                     ("a S" . agent-shell-send-region)
                     ("a f" . agent-shell-send-file)
                     ("a i f" . agent-shell-send-other-file)
                     ("a i i" . agent-shell-send-clipboard-image)
                     ("a i s" . agent-shell-send-screenshot)
                     ("a i d" . agent-shell-send-dwim)))
      (should (eq (lookup-key doom-leader-map (kbd (car entry))) (cdr entry)))))
  (dolist (key '("a e" "a y" "a c" "a J" "a K" "a C" "a V" "a F" "a s" "a d"))
    (should-not (lookup-key doom-leader-map (kbd key))))
  (should-not (lookup-key doom-leader-map (kbd "SPC")))
  (should (commandp (lookup-key doom-leader-map (kbd "f"))))
  (should (keymapp (lookup-key doom-leader-map (kbd "F"))))
  (should (= which-key-idle-delay 0.01))
  (should (= which-key-idle-secondary-delay 0.01)))

(ert-deftest josh/inline-visit-cycles-existing-previews ()
  (save-window-excursion
    (let ((first (generate-new-buffer " *inline-visit-a*"))
          (second (generate-new-buffer " *inline-visit-b*"))
          (agent-shell-inline--last-visited-preview nil)
          previews centred)
      (unwind-protect
          (progn
            (dolist (buffer (list first second))
              (with-current-buffer buffer
                (insert (make-string 100 ?\n) "Source\n")
                (goto-char 101)
                (push (agent-shell-inline--setup-response-overlay
                       (list :marker (point-marker) :buffer buffer)) previews)))
            (cl-letf (((symbol-function 'recenter)
                       (lambda (line &rest _) (setq centred line))))
              (dolist (buffer (list first second first))
                (agent-shell-inline-visit)
                (should (eq (current-buffer) buffer))
                (should (= (point) 101))
                (let* ((overlay agent-shell-inline--last-visited-preview)
                       (height (1+ (cl-count ?\n (overlay-get overlay 'after-string)))))
                  (should (= centred (max 0 (/ (- (window-body-height) height) 2))))))
              (agent-shell-inline-clear-response-overlay (car previews))
              (agent-shell-inline-visit)
              (should (eq (current-buffer) first))
              (agent-shell-inline-clear-response-overlay (cadr previews))
              (should-error (agent-shell-inline-visit) :type 'user-error)))
        (dolist (overlay previews)
          (when (overlay-buffer overlay)
            (agent-shell-inline-clear-response-overlay overlay)))
        (kill-buffer first)
        (kill-buffer second)))))

(ert-deftest josh/inline-quick-message-reuses-preview ()
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (insert "First\n" (make-string 100 ?\n) "Second\n" (make-string 100 ?\n) "Here\n")
      (let ((shell (generate-new-buffer " *quick-message-shell*"))
            first second reply)
        (unwind-protect
            (cl-letf (((symbol-function 'agent-shell-inline--resolve-shell)
                       (lambda (target) (should (eq target shell)) shell))
                      ((symbol-function 'agent-shell-inline--available-p) #'ignore)
                      ((symbol-function 'agent-shell-subscribe-to) (lambda (&rest _) nil))
                      ((symbol-function 'agent-shell-inline--submit-pending) #'ignore))
              (goto-char (point-min))
              (setq first (agent-shell-inline--setup-response-overlay
                           (list :marker (point-marker) :buffer shell)))
              (search-forward "Second")
              (setq second (agent-shell-inline--setup-response-overlay
                            (list :marker (point-marker) :buffer shell)))
              (overlay-put second 'agent-shell-inline-height 9)
              (goto-char (point-max))
              (set-window-start (selected-window) (line-beginning-position))
              (let ((position (overlay-start second)))
                (setq reply (agent-shell-inline-message "Follow up"))
                (should (= (overlay-start reply) position))
                (should (= (overlay-get reply 'agent-shell-inline-height) 9))
                (should-not (overlay-buffer second))
                (should (overlay-buffer first))
                (let ((context (overlay-get reply 'agent-shell-inline)))
                  (should (eq (plist-get context :buffer) shell))
                  (should (equal (plist-get context :prompt) "Follow up"))
                  (should-not (plist-get context :reference-ov))))
              (agent-shell-inline-clear-response-overlay first)
              (agent-shell-inline-clear-response-overlay reply)
              (setq reply (agent-shell-inline-message "Fresh message" shell))
              (should (= (overlay-start reply) (line-beginning-position))))
          (dolist (overlay (list first second reply))
            (when (and overlay (overlay-buffer overlay))
              (agent-shell-inline-clear-response-overlay overlay)))
          (kill-buffer shell))))))

(ert-deftest josh/inline-reply-uses-preview-conversation ()
  (save-window-excursion
    (let ((source (generate-new-buffer " *inline-reply-source*"))
          (shell (generate-new-buffer " *inline-reply-shell*"))
          (other (generate-new-buffer " *inline-other-shell*"))
          prompt overlay)
      (unwind-protect
          (progn
            (with-current-buffer shell (agent-shell-mode))
            (with-current-buffer other (agent-shell-mode))
            (switch-to-buffer source)
            (insert "Source\n")
            (goto-char (point-min))
            (setq-local agent-shell-inline--last other)
            (setq overlay (agent-shell-inline--setup-response-overlay
                           (list :marker (point-marker) :buffer shell)))
            (setq prompt (agent-shell-inline-reply))
            (should (eq (plist-get agent-shell-inline--context :buffer) shell))
            (should (eq (plist-get agent-shell-inline--context :response-ov) overlay))
            (should (buffer-live-p prompt)))
        (when overlay (agent-shell-inline-clear-response-overlay overlay))
        (dolist (buffer (list prompt source shell other))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

