(ert-deftest josh/inline-write-and-quit ()
  (dolist (text '("Review this code" "" " \n\t"))
    (save-window-excursion
      (let ((prompt (generate-new-buffer " *inline-write-quit*"))
            sent)
        (unwind-protect
            (progn
              (switch-to-buffer prompt)
              (agent-shell-inline-prompt-mode)
              (insert text)
              (setq agent-shell-inline--context (list :marker (point-marker)))
              (evil-normal-state)
              (should (eq (evil-ex-binding "wq")
                          #'agent-shell-inline-write-and-quit))
              (cl-letf (((symbol-function 'agent-shell-inline--send)
                         (lambda (message _context) (push message sent))))
                (evil-ex-execute "wq"))
              (should-not (buffer-live-p prompt))
              (should (equal sent (unless (string-empty-p (string-trim text))
                                    (list text)))))
          (when (buffer-live-p prompt) (kill-buffer prompt)))))))

(ert-deftest josh/inline-write-and-quit-keeps-failed-draft ()
  (save-window-excursion
    (let ((prompt (generate-new-buffer " *inline-failed-write-quit*")))
      (unwind-protect
          (progn
            (switch-to-buffer prompt)
            (agent-shell-inline-prompt-mode)
            (insert "Keep this draft")
            (setq agent-shell-inline--context (list :marker (point-marker)))
            (evil-normal-state)
            (cl-letf (((symbol-function 'agent-shell-inline--send)
                       (lambda (&rest _) (user-error "Agent is busy"))))
              (should-error (evil-ex-execute "wq") :type 'user-error))
            (should (buffer-live-p prompt))
            (should (equal (buffer-string) "Keep this draft")))
        (when (buffer-live-p prompt) (kill-buffer prompt))))))

