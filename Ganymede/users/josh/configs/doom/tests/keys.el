(ert-deftest josh/inline-doom-prompt ()
  (let ((shell (generate-new-buffer " *inline-key-shell*"))
        (source (generate-new-buffer " *inline-key-source*"))
        prompt)
    (save-window-excursion
      (unwind-protect
          (progn
            (with-current-buffer shell (agent-shell-mode))
            (switch-to-buffer source)
            (insert "selected source\n")
            (goto-char (point-min))
            (setq-local agent-shell-inline--last shell)
            (evil-normal-state)
            (execute-kbd-macro (kbd "v $ SPC a p"))
            (setq prompt (current-buffer))
            (should visual-line-mode)
            (should-not truncate-lines)
            (should (eq agent-shell-inline--reference-type 'region))
            (should-not (get-buffer-window shell))
            (evil-insert-state)
            (execute-kbd-macro (kbd "n p r + - 0 RET"))
            (should (equal (buffer-string) "npr+-0\n"))
            (should (eq (key-binding (kbd "C-c RET")) 'agent-shell-inline-send))
            (evil-normal-state)
            (should (eq (key-binding (kbd "RET")) 'agent-shell-inline-send))
            (should-not (key-binding (kbd "SPC m s")))
            (should (eq (key-binding (kbd "SPC a p")) 'agent-shell-inline))
            (should (eq (key-binding (kbd "SPC a m")) 'agent-shell-inline-message))
            (should (eq (key-binding (kbd "SPC a j")) 'agent-shell-inline--response-overlay-down))
            (should-not (lookup-key agent-shell-inline-map (kbd "M-RET")))
            (should-not (lookup-key agent-shell-inline--response-overlay-mode-map (kbd "M-RET")))
            (agent-shell-inline-cycle-reference)
            (should (eq agent-shell-inline--reference-type 'none))
            (agent-shell-inline-quit)
            (should-not (buffer-live-p prompt))
            (should (buffer-live-p shell)))
        (dolist (buffer (list prompt source shell))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest josh/agent-shell-command-bindings ()
  (should-not (featurep 'evil-collection-agent-shell))
  (dolist (map (list agent-shell-mode-map agent-shell-viewport-edit-mode-map
                     agent-shell-viewport-view-mode-map agent-shell-diff-mode-map
                     agent-shell-artist-mode-map))
    (dolist (state '(normal insert))
      (when-let* ((bindings (evil-get-auxiliary-keymap map state)))
        (map-keymap
         (lambda (_event binding)
           (when (and (symbolp binding)
                      (string-match-p "\\`\\(?:josh/\\)?agent-shell-"
                                      (symbol-name binding)))
             (should (commandp binding))))
         bindings)))))

