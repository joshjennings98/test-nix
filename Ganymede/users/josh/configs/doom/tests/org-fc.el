;;; org-fc.el --- Flashcard review key checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'evil)
(require 'evil-org)
(require 'org-fc)

(ert-deftest josh/org-fc-review-key-transitions ()
  (with-temp-buffer
    (org-mode)
    (evil-local-mode 1)
    (evil-org-mode 1)
    (evil-normal-state)
    (let ((org-fc-review--session t)
          (editing-return (key-binding (kbd "RET")))
          (editing-n (key-binding "n"))
          (editing-a (key-binding "a")))
      (dotimes (_ 2)
        (org-fc-review-flip-mode 1)
        (should (eq (key-binding (kbd "RET")) #'org-fc-review-flip))
        (should (eq (key-binding "n") #'org-fc-review-flip))
        (should (eq (key-binding "q") #'org-fc-review-quit))
        (org-fc-review-rate-mode 1)
        (dolist (binding '(("a" . org-fc-review-rate-again)
                           ("h" . org-fc-review-rate-hard)
                           ("g" . org-fc-review-rate-good)
                           ("e" . org-fc-review-rate-easy)
                           ("s" . org-fc-review-suspend-card)
                           ("p" . org-fc-review-edit)
                           ("q" . org-fc-review-quit)))
          (should (eq (key-binding (car binding)) (cdr binding))))
        (org-fc-review-edit-mode 1)
        (should (eq (key-binding (kbd "RET")) editing-return))
        (should (eq (key-binding "a") editing-a))
        (should (eq (key-binding "n") editing-n))
        (org-fc-review-edit-mode -1))
      (org-fc-review-flip-mode 1)
      (org-fc-review-flip-mode -1)
      (should (eq (key-binding (kbd "RET")) editing-return))
      (should (eq (key-binding "n") editing-n))
      (org-fc-review-rate-mode 1)
      (org-fc-review-rate-mode -1)
      (should (eq (key-binding "a") editing-a)))))
