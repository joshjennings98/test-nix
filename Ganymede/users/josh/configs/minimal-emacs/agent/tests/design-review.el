(ert-deftest josh/review-independent-sessions-submit-before-completion ()
  (require 'agent-shell)
  (josh/with-review
    (let ((document (design-review--document)) shells submitted)
      (unwind-protect
          (cl-letf (((symbol-function 'agent-shell--new-shell)
                     (lambda (&rest _) (let ((shell (generate-new-buffer " *parallel-review*")))
                                         (push shell shells) shell)))
                    ((symbol-function 'agent-shell-initialized-p) (lambda (&rest _) t))
                    ((symbol-function 'agent-shell-subscribe-to) (lambda (&rest _) 'fixture))
                    ((symbol-function 'agent-shell-unsubscribe) #'ignore)
                    ((symbol-function 'agent-shell-insert)
                     (lambda (&rest args) (push (plist-get args :shell-buffer) submitted))))
            (dolist (id '("planned-implementation" "changes-outside-plan"))
              (design-review--start-review (design-review--block id) document))
            (dolist (shell shells) (design-review--advance shell))
            (should (= (length (delete-dups submitted)) 2))
            (dolist (id '("planned-implementation" "changes-outside-plan"))
              (should (plist-get (gethash (cons (current-buffer) id) design-review--runs) :submitted))))
        (dolist (id '("planned-implementation" "changes-outside-plan"))
          (remhash (cons (current-buffer) id) design-review--runs))
        (dolist (shell shells)
          (with-current-buffer shell (setq design-review--queue nil))
          (kill-buffer shell))))))
