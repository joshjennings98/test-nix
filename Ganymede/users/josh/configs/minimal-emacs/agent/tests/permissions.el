;;; permissions.el --- Offline permission review checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'evil)
(load (expand-file-name "../agent-shell-permission-transient.el"
                        (file-name-directory load-file-name)) nil t)
(load (expand-file-name "inline.el" (file-name-directory load-file-name)) nil t)

(defmacro josh/with-permission-review (&rest body)
  "Run BODY with isolated permissions and real source/shell buffers."
  (declare (indent 0) (debug t))
  `(let ((agent-shell-permission-transient--queue nil)
         (agent-shell-permission-transient--current nil)
         (agent-shell-permission-transient--shell-buffer nil)
         (agent-shell-permission-transient--owner-window nil)
         (agent-shell-permission-transient--owner-buffer nil)
         (agent-shell-permission-transient--subscriptions (make-hash-table :test #'eq))
         (agent-shell-permission-transient--previous-responder nil)
         (agent-shell-permission-responder-function #'agent-shell-permission-transient--responder)
         (agent-shell-permission-transient-mode t))
     (unwind-protect
         (josh/with-inline-agent ,@body)
       (when (transient-active-prefix)
         (transient--emergency-exit :test-cleanup))
       (agent-shell-permission-transient--clear-owner)
       (agent-shell-permission-transient--unsubscribe-all))))

(defun josh/permission-request (shell id respond &optional command)
  "Queue a synthetic permission for SHELL with ID and RESPOND callback."
  (with-current-buffer shell
    (agent-shell-permission-transient--responder
     `((:tool-call . ((:permission-request-id . ,id)
                     (:title . "Synthetic request")
                     (:kind . "execute")
                     (:raw-input . ((command . ,(or command "printf example"))))))
       (:options . (((:kind . "allow_once") (:option-id . "allow"))
                    ((:kind . "reject_once") (:option-id . "reject"))))
       (:respond . ,respond)))))

(ert-deftest josh/permission-inline-manual-approval ()
  (josh/with-permission-review
    (let* ((window (selected-window))
           (position (point))
           (overlay (agent-shell-inline-message "TEST_PERMISSION" shell)))
      (josh/inline-wait (lambda () (overlay-get overlay 'agent-shell-inline-review)))
      (should (eq (agent-shell-status :shell-buffer shell) 'blocked))
      (should-not (transient-active-prefix))
      (should (eq (current-buffer) source))
      (should-not (get-buffer-window shell))
      (evil-local-mode 1)
      (evil-normal-state)
      (agent-shell-inline-review overlay)
      (should (eq (key-binding (kbd "y")) #'agent-shell-permission-transient--allow-once))
      (execute-kbd-macro (kbd "y"))
      (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get overlay 'agent-shell-inline-status))))
      (should-not (transient-active-prefix))
      (should-not agent-shell-permission-transient--queue)
      (should (eq (selected-window) window))
      (should (eq (current-buffer) source))
      (should (= (point) position))
      (should (evil-normal-state-p))
      (should (eq (key-binding (kbd "y")) #'evil-yank))
      (should-not (get-buffer-window shell)))))

(ert-deftest josh/permission-defer-and-insert-state ()
  (dolist (key '("q" "<escape>" "C-g"))
    (josh/with-permission-review
      (let (answered)
        (evil-local-mode 1)
        (evil-insert-state)
        (josh/permission-request shell 1 (lambda (option) (setq answered option)))
        (execute-kbd-macro "yn")
        (should (string-prefix-p "yn" (buffer-string)))
        (should-not answered)
        (agent-shell-permission-transient-menu shell)
        (execute-kbd-macro (kbd key))
        (should-not answered)
        (should-not (transient-active-prefix))
        (should (evil-insert-state-p))
        (should (= 1 (agent-shell-permission-transient-pending-count)))
        (should (eq (current-buffer) source))))))

(ert-deftest josh/permission-queue-is-conversation-scoped ()
  (josh/with-permission-review
    (let ((other (generate-new-buffer " *other-permission-shell*"))
          answered)
      (unwind-protect
          (progn
            (with-current-buffer other
              (setq-local major-mode 'agent-shell-mode)
              (setq-local agent-shell--state (agent-shell--make-state :buffer other)))
            (josh/permission-request shell 1 (lambda (_) (push 'first answered)))
            (josh/permission-request other 1 (lambda (_) (push 'other answered)))
            (josh/permission-request shell 2 (lambda (_) (push 'second answered)))
            (agent-shell-permission-transient-menu shell)
            (execute-kbd-macro (kbd "N y"))
            (should (equal answered '(second)))
            (should (= 1 (agent-shell-permission-transient--buffer-pending-count shell)))
            (should (= 1 (agent-shell-permission-transient--buffer-pending-count other)))
            (should-not (transient-active-prefix)))
        (agent-shell-permission-transient--remove-shell other)
        (kill-buffer other)))))

(ert-deftest josh/permission-external-response-invalidates-menu ()
  (josh/with-permission-review
    (let (answered)
      (josh/permission-request shell 1 #'ignore)
      (josh/permission-request shell 2 (lambda (_) (setq answered t)))
      (agent-shell-permission-transient-menu shell)
      (let ((request agent-shell-permission-transient--current))
        (agent-shell-permission-transient--on-response shell '((:data . ((:request-id . 1)))))
        (should-not (transient-active-prefix))
        (should-not agent-shell-permission-transient--current)
        (should-error (agent-shell-permission-transient--respond request "allow_once") :type 'user-error)
        (should-not answered)))))

(ert-deftest josh/permission-details-are-complete-and-non-authorising ()
  (josh/with-permission-review
    (let ((command (concat (make-string 150 ?x) "\nimportant tail"))
          (window (selected-window))
          answered)
      (josh/permission-request shell 1 (lambda (_) (setq answered t)) command)
      (agent-shell-permission-transient-menu shell)
      (execute-kbd-macro (kbd "i"))
      (should (derived-mode-p 'agent-shell-permission-transient-details-mode))
      (should buffer-read-only)
      (should (string-match-p "important tail" (buffer-string)))
      (should (string-match-p (make-string 150 ?x) (buffer-string)))
      (should-not answered)
      (quit-window)
      (should (eq (selected-window) window))
      (should (eq (current-buffer) source)))))

(ert-deftest josh/permission-reject-interrupts-correct-shell ()
  (josh/with-permission-review
    (let ((overlay (agent-shell-inline-message "TEST_PERMISSION" shell)))
      (josh/inline-wait (lambda () (overlay-get overlay 'agent-shell-inline-review)))
      (agent-shell-inline-review overlay)
      (execute-kbd-macro (kbd "n"))
      (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get overlay 'agent-shell-inline-status))))
      (should-not agent-shell-permission-transient--queue)
      (should (eq (current-buffer) source)))))

(ert-deftest josh/permission-window-change-refuses-approval ()
  (josh/with-permission-review
    (let (answered)
      (josh/permission-request shell 1 (lambda (_) (setq answered t)))
      (agent-shell-permission-transient-menu shell)
      (select-window (split-window-below))
      (should-error (agent-shell-permission-transient--allow-once) :type 'user-error)
      (should-not answered))))

(ert-deftest josh/permission-multiple-requests-keep-review-status ()
  (josh/with-permission-review
    (let ((overlay (agent-shell-inline-message "TEST_PERMISSION" shell)))
      (josh/inline-wait (lambda () (overlay-get overlay 'agent-shell-inline-review)))
      (josh/permission-request shell 2 #'ignore)
      (agent-shell-inline--on-event overlay '((:event . permission-response)
                                              (:data . ((:request-id . "permission-1")))))
      (should (eq (overlay-get overlay 'agent-shell-inline-review) 'permission-request)))))

(ert-deftest josh/permission-diff-returns-to-source-and-rejects-stale-review ()
  (josh/with-permission-review
    (let ((window (selected-window))
          answered)
      (josh/permission-request shell 1 (lambda (_) (setq answered t)))
      (setf (map-elt (map-elt (agent-shell-permission-transient--request-permission
                              (car agent-shell-permission-transient--queue)) :tool-call) :diffs)
            '(((:old . "before\n") (:new . "after\n") (:file . "/tmp/permission-example.txt"))))
      (agent-shell-permission-transient-menu shell)
      (execute-kbd-macro (kbd "v"))
      (should (derived-mode-p 'agent-shell-diff-mode))
      (let ((diff (current-buffer)))
        (unwind-protect
            (progn
              (agent-shell-permission-transient--remove-by-id shell 1)
              (should-error (agent-shell-diff-accept-all) :type 'user-error)
              (should-not answered))
          (when (buffer-live-p diff)
            (execute-kbd-macro (kbd "q")))))
      (should (eq (selected-window) window))
      (should (eq (current-buffer) source))
      (should-not (get-buffer-window shell)))))

(ert-deftest josh/permission-bypass-is-confirmed-and-session-local ()
  (josh/with-permission-review
    (let ((count 0))
      (josh/permission-request shell 1 (lambda (_) (cl-incf count)))
      (agent-shell-permission-transient-menu shell)
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (_) nil)))
        (execute-kbd-macro (kbd "B")))
      (should (= count 0))
      (agent-shell-permission-transient-menu shell)
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (_) t)))
        (execute-kbd-macro (kbd "B")))
      (should (= count 1))
      (josh/permission-request shell 2 (lambda (_) (cl-incf count)))
      (should (= count 2))
      (agent-shell-permission-transient--remove-shell shell)
      (should-not (buffer-local-value 'agent-shell-permission-transient--bypass-permissions shell))
      (josh/permission-request shell 3 (lambda (_) (cl-incf count)))
      (should (= count 2))
      (should (= 1 (agent-shell-permission-transient-pending-count))))))

(ert-deftest josh/permission-replacement-invalidates-old-callback ()
  (josh/with-permission-review
    (josh/permission-request shell 1 #'ignore)
    (let ((request (car agent-shell-permission-transient--queue)))
      (josh/permission-request shell 1 #'ignore "changed command")
      (should (= 1 (agent-shell-permission-transient-pending-count)))
      (should-error (agent-shell-permission-transient--respond request "allow_once") :type 'user-error))))

(ert-deftest josh/permission-mode-restores-responder-and-protects-pending ()
  (let ((agent-shell-permission-responder-function #'ignore)
        (agent-shell-permission-transient--previous-responder nil)
        (agent-shell-permission-transient--queue nil)
        (agent-shell-permission-transient--subscriptions (make-hash-table :test #'eq))
        (agent-shell-permission-transient-mode nil))
    (unwind-protect
        (progn
          (agent-shell-permission-transient-mode 1)
          (agent-shell-permission-transient-mode 1)
          (should (eq agent-shell-permission-transient--previous-responder #'ignore))
          (let ((agent-shell-permission-transient--queue '(pending)))
            (should-error (agent-shell-permission-transient-mode -1) :type 'user-error)
            (should agent-shell-permission-transient-mode))
          (agent-shell-permission-transient-mode -1)
          (should (eq agent-shell-permission-responder-function #'ignore)))
      (agent-shell-permission-transient-mode -1))))

(ert-deftest josh/permission-inline-click-approves-without-opening-shell ()
  (josh/with-permission-review
    (let ((overlay (agent-shell-inline-message "TEST_PERMISSION" shell)))
      (josh/inline-wait (lambda () (agent-shell-inline--pending-permissions overlay)))
      (agent-shell-inline--check-activity overlay)
      (should-not (overlay-get overlay 'agent-shell-inline-activity))
      (let* ((text (overlay-get overlay 'after-string))
             (label (string-match "Approve:" text))
             (index (text-property-any label (length text) 'face 'help-key-binding text))
             (event (list 'mouse-1
                          (list (selected-window) 1 '(0 . 0) 0 (cons text index)))))
        (should index)
        (should-not (get-text-property label 'face text))
        (should (eq (lookup-key (get-text-property label 'keymap text) [mouse-1]) #'agent-shell-inline--focus-from-click))
        (should (eq (get-text-property index 'face text) 'help-key-binding))
        (agent-shell-inline--click event))
      (josh/inline-wait (lambda () (string-prefix-p "Finished" (overlay-get overlay 'agent-shell-inline-status))))
      (should-not (agent-shell-inline--pending-permissions overlay))
      (should-not (overlay-get overlay 'agent-shell-inline-timer))
      (should (eq (current-buffer) source))
      (should-not (get-buffer-window shell)))))

(ert-deftest josh/permission-inline-approve-all-is-a-conversation-snapshot ()
  (josh/with-permission-review
    (let ((overlay (agent-shell-inline--setup-response-overlay
                    (list :marker (point-marker) :buffer shell)))
          (other (generate-new-buffer " *other-approval-shell*"))
          answered)
      (unwind-protect
          (progn
            (with-current-buffer other (agent-shell-mode))
            (josh/permission-request other "other" (lambda (_) (ert-fail "Approved another conversation")))
            (josh/permission-request
             shell "first"
             (lambda (option)
               (push (cons "first" option) answered)
               (josh/permission-request shell "later" (lambda (_) (ert-fail "Approved a future request")))))
            (josh/permission-request shell "second" (lambda (option) (push (cons "second" option) answered)))
            (agent-shell-inline-approve overlay t)
            (should (equal (reverse answered) '(("first" . "allow") ("second" . "allow"))))
            (should (= 1 (agent-shell-permission-transient--buffer-pending-count shell)))
            (should (= 1 (agent-shell-permission-transient--buffer-pending-count other)))
            (should-not (buffer-local-value 'agent-shell-permission-transient--bypass-permissions shell))
            (should (eq (current-buffer) source)))
        (agent-shell-inline-clear-response-overlay overlay)
        (kill-buffer other)))))
