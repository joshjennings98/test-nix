;;; emacs2-gruvbox-theme.el --- Local Gruvbox palette -*- lexical-binding: t; -*-

;; Adapted from ../emacs/theme.org, including its ST/Ghostel terminal palette.
(deftheme emacs2-gruvbox "Custom dark Gruvbox for the emacs2 package set.")

(defface emacs2-gruvbox-argument
  '((t :inherit font-lock-variable-name-face))
  "Go arguments and parameters."
  :group 'font-lock-faces)
(defface emacs2-gruvbox-package-keyword
  '((t :inherit font-lock-keyword-face))
  "Go package and import keywords."
  :group 'font-lock-faces)

(let ((bg0 "#282828") (bg1 "#3c3836") (bg2 "#504945")
      (bg3 "#665c54") (bg4 "#7c6f64")
      (fg1 "#ebdbb2") (fg2 "#d5c4a1") (fg3 "#bdae93") (fg4 "#a89984")
      (gray "#928374") (red "#fb4934") (green "#b8bb26")
      (yellow "#fabd2f") (blue "#83a598") (purple "#d3869b")
      (aqua "#8ec07c") (orange "#fe8019")
      (dark-red "#cc241d") (dark-green "#98971a") (dark-yellow "#d79921")
      (dark-blue "#458588") (dark-purple "#b16286") (dark-aqua "#689d6a"))
  (custom-theme-set-faces
   'emacs2-gruvbox
   ;; Shared UI faces also colour packages which inherit standard faces.
   `(default ((t (:foreground ,fg1 :background ,bg0))))
   `(cursor ((t (:background ,gray))))
   `(fringe ((t (:background ,bg1))))
   `(region ((t (:background ,bg3 :extend t))))
   `(highlight ((t (:background ,bg2))))
   `(hl-line ((t (:background ,bg1 :extend t))))
   `(shadow ((t (:foreground ,gray))))
   `(success ((t (:foreground ,green :weight bold))))
   `(warning ((t (:foreground ,yellow :weight bold))))
   `(error ((t (:foreground ,red :weight bold))))
   `(minibuffer-prompt ((t (:foreground ,aqua :weight bold))))
   `(vertical-border ((t (:foreground ,bg4))))
   `(window-divider ((t (:foreground ,bg2))))
   `(window-divider-first-pixel ((t (:foreground ,bg2))))
   `(window-divider-last-pixel ((t (:foreground ,bg2))))
   `(mode-line ((t (:foreground ,fg2 :background ,bg2 :box nil))))
   `(mode-line-inactive ((t (:foreground ,fg4 :background ,bg1 :box nil))))
   `(mode-line-buffer-id ((t (:foreground ,yellow :weight bold))))
   `(mode-line-emphasis ((t (:foreground ,aqua :weight bold))))
   `(emacs2-mode-line-state ((t (:foreground ,aqua :weight bold))))
   `(header-line ((t (:foreground ,fg2 :background ,bg1 :box nil))))
   `(link ((t (:foreground ,blue :underline t))))
   `(link-visited ((t (:foreground ,purple :underline t))))
   `(button ((t (:inherit link))))
   `(match ((t (:foreground ,bg0 :background ,yellow :weight bold))))
   `(isearch ((t (:inherit match))))
   `(lazy-highlight ((t (:foreground ,orange :background ,bg0 :weight bold))))
   `(isearch-fail ((t (:foreground ,fg1 :background ,dark-red))))

   ;; Syntax: use standard semantic faces across tree-sitter language modes.
   `(font-lock-builtin-face ((t (:foreground ,orange))))
   `(font-lock-comment-face ((t (:foreground ,gray :slant italic))))
   `(font-lock-comment-delimiter-face ((t (:inherit font-lock-comment-face))))
   `(font-lock-doc-face ((t (:inherit font-lock-comment-face))))
   `(font-lock-constant-face ((t (:foreground ,purple))))
   `(font-lock-function-name-face ((t (:foreground ,green :weight bold))))
   `(font-lock-function-call-face ((t (:foreground ,green))))
   `(font-lock-keyword-face ((t (:foreground ,red :weight bold))))
   `(font-lock-string-face ((t (:foreground ,green :slant italic))))
   `(font-lock-type-face ((t (:foreground ,yellow))))
   `(font-lock-variable-name-face ((t (:foreground ,fg1))))
   `(font-lock-variable-use-face ((t (:inherit font-lock-variable-name-face))))
   `(font-lock-number-face ((t (:foreground ,purple))))
   `(font-lock-operator-face ((t (:foreground ,purple))))
   `(font-lock-bracket-face ((t (:foreground ,orange))))
   `(font-lock-delimiter-face ((t (:foreground ,orange))))
   `(font-lock-property-name-face ((t (:foreground ,blue))))
   `(font-lock-property-use-face ((t (:inherit font-lock-property-name-face))))
   `(font-lock-escape-face ((t (:foreground ,aqua))))
   `(font-lock-regexp-face ((t (:foreground ,aqua))))
   `(font-lock-negation-char-face ((t (:foreground ,orange))))
   `(font-lock-warning-face ((t (:inherit error))))
   `(emacs2-gruvbox-argument ((t (:foreground ,blue))))
   `(emacs2-gruvbox-package-keyword ((t (:foreground ,aqua :weight bold))))

   ;; Completion, preview and navigation.
   `(completions-common-part ((t (:foreground ,yellow :weight bold))))
   `(completions-first-difference ((t (:foreground ,orange))))
   `(completions-annotations ((t (:foreground ,gray))))
   `(vertico-current ((t (:foreground ,fg1 :background ,bg2 :extend t))))
   `(vertico-group-title ((t (:foreground ,aqua :weight bold))))
   `(orderless-match-face-0 ((t (:foreground ,yellow :weight bold))))
   `(orderless-match-face-1 ((t (:foreground ,aqua :weight bold))))
   `(orderless-match-face-2 ((t (:foreground ,purple :weight bold))))
   `(orderless-match-face-3 ((t (:foreground ,orange :weight bold))))
   `(corfu-default ((t (:background ,bg1 :foreground ,fg1))))
   `(corfu-current ((t (:foreground ,fg1 :background ,bg2))))
   `(corfu-bar ((t (:background ,bg3))))
   `(corfu-border ((t (:background ,bg1))))
   `(corfu-popupinfo ((t (:foreground ,fg1 :background ,bg1))))
   `(corfu-annotations ((t (:foreground ,gray))))
   `(consult-preview-line ((t (:background ,bg1 :extend t))))
   `(consult-preview-match ((t (:inherit match))))
   `(consult-highlight-match ((t (:foreground ,yellow :weight bold))))
   `(consult-file ((t (:foreground ,aqua))))
   `(consult-buffer ((t (:foreground ,blue))))
   `(consult-line-number ((t (:foreground ,gray))))
   `(consult-key ((t (:foreground ,orange))))
   `(marginalia-documentation ((t (:foreground ,fg4))))
   `(marginalia-key ((t (:foreground ,orange))))
   `(marginalia-file-name ((t (:foreground ,aqua))))
   `(embark-target ((t (:background ,bg2 :underline ,yellow))))
   `(embark-keybinding ((t (:foreground ,orange :weight bold))))
   `(which-key-key-face ((t (:foreground ,orange))))
   `(which-key-group-description-face ((t (:foreground ,aqua))))
   `(which-key-command-description-face ((t (:foreground ,fg1))))
   `(which-key-separator-face ((t (:foreground ,gray))))
   `(avy-lead-face ((t (:foreground ,bg0 :background ,yellow :weight bold))))
   `(avy-lead-face-0 ((t (:foreground ,bg0 :background ,aqua :weight bold))))
   `(avy-lead-face-1 ((t (:foreground ,bg0 :background ,purple :weight bold))))
   `(avy-lead-face-2 ((t (:foreground ,bg0 :background ,orange :weight bold))))
   `(avy-background-face ((t (:foreground ,gray))))

   ;; Eglot, diagnostics and changes.
   `(eglot-inlay-hint-face ((t (:foreground ,gray :height 0.9))))
   `(eglot-highlight-symbol-face ((t (:background ,bg2 :weight bold))))
   `(flymake-error ((t (:underline (:style wave :color ,red)))))
   `(flymake-warning ((t (:underline (:style wave :color ,yellow)))))
   `(flymake-note ((t (:underline (:style wave :color ,aqua)))))
   `(diff-added ((t (:foreground ,green :background ,bg1 :extend t))))
   `(diff-removed ((t (:foreground ,red :background ,bg1 :extend t))))
   `(diff-changed ((t (:foreground ,aqua :background ,bg1 :extend t))))
   `(diff-refine-added ((t (:foreground ,bg0 :background ,green))))
   `(diff-refine-removed ((t (:foreground ,bg0 :background ,red))))
   `(diff-header ((t (:foreground ,yellow :background ,bg2))))
   `(diff-file-header ((t (:foreground ,aqua :background ,bg2 :weight bold))))
   `(diff-hl-insert ((t (:foreground ,green :background ,green))))
   `(diff-hl-delete ((t (:foreground ,red :background ,red))))
   `(diff-hl-change ((t (:foreground ,aqua :background ,aqua))))
   `(diff-hl-margin-insert ((t (:foreground ,green))))
   `(diff-hl-margin-delete ((t (:foreground ,red))))
   `(diff-hl-margin-change ((t (:foreground ,aqua))))
   `(treesit-fold-replacement-face ((t (:foreground ,gray :background ,bg1))))
   `(page-break-lines ((t (:foreground ,bg3))))

   ;; Org and Markdown.
   `(org-level-1 ((t (:foreground ,green :weight bold))))
   `(org-level-2 ((t (:foreground ,yellow))))
   `(org-level-3 ((t (:foreground ,blue))))
   `(org-level-4 ((t (:foreground ,orange))))
   `(org-level-5 ((t (:foreground ,purple))))
   `(org-level-6 ((t (:foreground ,aqua))))
   `(org-level-7 ((t (:foreground ,green))))
   `(org-level-8 ((t (:foreground ,yellow))))
   `(org-hide ((t (:foreground ,bg0 :background ,bg0))))
   `(org-indent ((t (:inherit org-hide))))
   `(org-code ((t (:foreground ,aqua))))
   `(org-verbatim ((t (:foreground ,yellow))))
   `(org-block ((t (:inherit fixed-pitch :foreground ,fg1 :background ,bg1 :extend t))))
   `(org-block-begin-line ((t (:foreground ,gray :background ,bg1 :extend t))))
   `(org-block-end-line ((t (:inherit org-block-begin-line))))
   `(org-table ((t (:inherit fixed-pitch :foreground ,fg1))))
   `(org-todo ((t (:foreground ,red :weight bold))))
   `(org-done ((t (:foreground ,green :weight bold))))
   `(org-date ((t (:foreground ,blue :underline t))))
   `(org-tag ((t (:foreground ,aqua))))
   `(markdown-header-face-1 ((t (:inherit org-level-1))))
   `(markdown-header-face-2 ((t (:inherit org-level-2))))
   `(markdown-header-face-3 ((t (:inherit org-level-3))))
   `(markdown-header-face-4 ((t (:inherit org-level-4))))
   `(markdown-header-face-5 ((t (:inherit org-level-5))))
   `(markdown-header-face-6 ((t (:inherit org-level-6))))
   `(markdown-code-face ((t (:foreground ,aqua :background ,bg1))))
   `(markdown-pre-face ((t (:foreground ,fg1 :background ,bg1))))
   `(markdown-markup-face ((t (:foreground ,gray))))
   `(markdown-link-face ((t (:inherit link))))

   ;; Clojure syntax, REPL results, tests and debugging.
   `(clojure-keyword-face ((t (:foreground ,purple))))
   `(clojure-character-face ((t (:foreground ,aqua))))
   `(clojure-discard-face ((t (:foreground ,gray :slant italic))))
   `(cider-repl-prompt-face ((t (:foreground ,aqua :weight bold))))
   `(cider-repl-input-face ((t (:foreground ,fg1))))
   `(cider-repl-result-face ((t (:foreground ,green))))
   `(cider-repl-stdout-face ((t (:foreground ,fg2))))
   `(cider-repl-stderr-face ((t (:foreground ,red))))
   `(cider-result-overlay-face ((t (:foreground ,aqua :background ,bg1))))
   `(cider-error-overlay-face ((t (:foreground ,red :background ,bg1))))
   `(cider-error-highlight-face ((t (:inherit flymake-error))))
   `(cider-warning-highlight-face ((t (:inherit flymake-warning))))
   `(cider-test-success-face ((t (:foreground ,green :weight bold))))
   `(cider-test-failure-face ((t (:foreground ,red :weight bold))))
   `(cider-test-error-face ((t (:foreground ,orange :weight bold))))
   `(cider-fringe-good-face ((t (:foreground ,green))))
   `(cider-fringe-bad-face ((t (:foreground ,red))))
   `(cider-fringe-stale-face ((t (:foreground ,yellow))))
   `(cider-debug-code-overlay-face ((t (:background ,bg2))))
   `(cider-debug-prompt-face ((t (:foreground ,yellow :weight bold))))
   `(cider-enlightened-face ((t (:foreground ,aqua :background ,bg1))))
   `(cider-enlightened-local-face ((t (:foreground ,yellow :background ,bg1))))
   `(cider-instrumented-face ((t (:foreground ,orange :underline t))))
   `(cider-traced-face ((t (:foreground ,purple :underline t))))

   ;; Ghostel's colour faces inherit the ANSI palette below.
   `(ghostel-default ((t (:foreground ,fg1 :background ,bg0))))
   `(ghostel-fake-cursor ((t (:foreground ,gray))))
   `(ghostel-fake-cursor-box ((t (:foreground ,bg0 :background ,gray)))))

  (dolist (entry `((black . ,bg3) (red . ,dark-red) (green . ,dark-green)
                   (yellow . ,dark-yellow) (blue . ,dark-blue) (magenta . ,dark-purple)
                   (cyan . ,dark-aqua) (white . ,fg4) (bright-black . ,bg4)
                   (bright-red . ,red) (bright-green . ,green) (bright-yellow . ,yellow)
                   (bright-blue . ,blue) (bright-magenta . ,purple)
                   (bright-cyan . ,aqua) (bright-white . ,fg3)))
    (custom-theme-set-faces
     'emacs2-gruvbox
     `(,(intern (format "ansi-color-%s" (car entry)))
       ((t (:foreground ,(cdr entry) :background ,(cdr entry))))))))

(provide-theme 'emacs2-gruvbox)
;;; emacs2-gruvbox-theme.el ends here
