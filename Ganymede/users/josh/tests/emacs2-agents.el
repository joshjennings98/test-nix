;;; emacs2-agents.el --- Agent workflow integration checks -*- lexical-binding: t; -*-

(require 'ert)

(ert-deftest emacs2-agent-entry-points-and-local-leaders ()
  (dolist (binding emacs2-agent-bindings)
    (should (commandp (cdr binding)))
    (should (eq (lookup-key emacs2-leader-map (kbd (concat "a " (car binding))))
                (cdr binding))))
  (with-temp-buffer
    (org-mode)
    (evil-normal-state)
    (should (eq (key-binding (kbd "SPC m D a")) #'design-review-check-document))
    (should (eq (key-binding (kbd "SPC f")) #'project-find-file)))
  (with-temp-buffer
    (agent-shell-inline-prompt-mode)
    (evil-insert-state)
    (should (eq (key-binding (kbd "RET")) #'newline))
    (evil-normal-state)
    (should (eq (key-binding (kbd "RET")) #'agent-shell-inline-send))
    (should (eq (key-binding (kbd "SPC m m")) #'agent-shell-inline-cycle-reference))
    (should (eq (key-binding (kbd "SPC f")) #'project-find-file))
    (should (eq (command-remapping 'evil-save-and-close) #'agent-shell-inline-write-and-quit)))
  (dolist (map (list agent-shell-mode-map agent-shell-viewport-view-mode-map
                     agent-shell-viewport-edit-mode-map agent-shell-diff-mode-map))
    (cl-labels ((check (map)
                  (map-keymap (lambda (_ binding)
                                (if (keymapp binding)
                                    (check binding)
                                  (should (commandp binding)))) map)))
      (check (lookup-key map (kbd "C-c m"))))))

(ert-deftest emacs2-agent-state-stays-outside-projects ()
  (let ((root (make-temp-file "agent-state-project-" t)))
    (cl-letf (((symbol-function 'agent-shell-cwd) (lambda () root)))
      (dolist (subdir '("transcripts" "screenshots"))
        (should (file-in-directory-p (agent-shell--dot-subdir subdir) emacs2-state-directory)))
      (should-not (file-exists-p (expand-file-name ".agent-shell" root)))
      (should-not (file-exists-p (expand-file-name ".gitignore" root))))
    (should (file-in-directory-p (agent-shell-cache-dir "content") emacs2-state-directory))
    (should (file-in-directory-p shell-maker-root-path emacs2-state-directory))))

(ert-deftest emacs2-agent-core-features-loaded ()
  (dolist (feature '(agent-shell agent-shell-inline agent-shell-permission-transient
                     agent-shell-output-limit agent-shell-completion-notify
                     agent-shell-navigation design-review design-review-execution
                     design-review-async design-review-mcp org-mermaid))
    (should (featurep feature)))
  (should agent-shell-permission-transient-mode)
  (should-not agent-shell-inhibit-system-sleep)
  (should (file-exists-p ob-mermaid-default-config-file))
  (should (eq agent-shell-preferred-agent-config 'codex))
  (let ((config (agent-shell-openai-make-codex-config)))
    (should (equal (funcall (alist-get :default-model-id config)) "gpt-6.2-sol"))
    (should (equal (alist-get "reasoning_effort" (funcall (alist-get :default-config-options config))
                              nil nil #'equal)
                   "medium"))))

(ert-deftest emacs2-inline-session-and-preview-shortcuts ()
  (dolist (binding '(("L" . agent-shell-inline-continue-session)
                     ("S" . agent-shell-inline-select-session)
                     ("c" . agent-shell-inline-cycle)
                     ("C" . agent-shell-inline-visit)
                     ("i r" . agent-shell-send-region)))
    (should (eq (lookup-key emacs2-agent-map (kbd (car binding))) (cdr binding))))
  (should (equal (alist-get 'agent-shell-inline-select-session agent-shell-inline-key-bindings)
                 "SPC a S")))

(ert-deftest emacs2-inline-composer-cancel-hint-and-click-target ()
  (save-window-excursion
    (let ((prompt (generate-new-buffer " *cancel-hint*")))
      (unwind-protect
          (progn
            (switch-to-buffer prompt)
            (agent-shell-inline-prompt-mode)
            (let* ((header (agent-shell-inline--prompt-header))
                   (label (string-match "Cancel: :q" header))
                   (shortcut (+ label (length "Cancel: "))))
              (should (string-match-p "Send: :wq, Cancel: :q" header))
              (should-not (get-text-property 4 'face header))
              (should-not (get-text-property label 'face header))
              (should (eq (get-text-property shortcut 'face header) 'help-key-binding))
              (call-interactively (lookup-key (get-text-property label 'keymap header) [header-line mouse-1]))
              (should (buffer-live-p prompt))
              (call-interactively (lookup-key (get-text-property shortcut 'keymap header) [header-line mouse-1]))
              (should-not (buffer-live-p prompt))))
        (when (buffer-live-p prompt) (kill-buffer prompt))))))

(ert-deftest emacs2-inline-header-fits-narrow-windows-with-long-session-name ()
  (save-window-excursion
    (let ((shell (generate-new-buffer (concat "Codex session " (make-string 160 ?x)))))
      (unwind-protect
          (with-temp-buffer
            (switch-to-buffer (current-buffer))
            (agent-shell-inline-prompt-mode)
            (setq agent-shell-inline--context (list :buffer shell))
            (dolist (width '(140 100 72 48 28))
              (cl-letf (((symbol-function 'window-body-width) (lambda (&rest _) width)))
                (let* ((header (agent-shell-inline--prompt-header))
                       (display (copy-sequence header)))
                  (let* ((spacer (text-property-not-all 0 (length header) 'display nil header))
                         (alignment (get-text-property spacer 'display header)))
                    (should (eq (car alignment) 'space))
                    (should (eq (car (plist-get (cdr alignment) :align-to)) '-))
                    (should (eq (cadr (plist-get (cdr alignment) :align-to)) 'right)))
                  (should-not (string-match-p " | " header))
                  (remove-text-properties 0 (length display) '(display nil) display)
                  (add-face-text-property 0 (length display) 'header-line t display)
                  (should (<= (string-pixel-width display (current-buffer)) width))
                  (should (string-match-p ":wq" header))
                  (should (string-match-p ":q" header))
                  (let* ((help (string-match "SPC m h" header))
                         (action (lookup-key (get-text-property help 'keymap header) [header-line mouse-1]))
                         opened)
                    (should help)
                    (should (eq (get-text-property help 'face header) 'help-key-binding))
                    (cl-letf (((symbol-function 'agent-shell-inline-help)
                               (lambda () (interactive) (setq opened (current-buffer)))))
                      (call-interactively action))
                    (should (eq opened (current-buffer))))))))
        (kill-buffer shell)))))

(ert-deftest emacs2-inline-input-shortcuts-click-in-the-owning-draft ()
  (save-window-excursion
    (let ((prompt (generate-new-buffer " *clickable-draft*"))
          (other (generate-new-buffer " *clickable-source*")))
      (unwind-protect
          (progn
            (switch-to-buffer prompt)
            (agent-shell-inline-prompt-mode)
            (let* ((prompt-window (selected-window))
                   (other-window (split-window-below))
                   (header (cl-letf (((symbol-function 'window-body-width) (lambda (&rest _) 1000)))
                             (agent-shell-inline--prompt-header))))
              (set-window-buffer other-window other)
              (dolist (command '(agent-shell-inline-select-session agent-shell-inline-cycle-reference
                                  agent-shell-inline-send agent-shell-inline-quit agent-shell-inline-help))
                (let* ((hint (alist-get command agent-shell-inline-key-bindings))
                       (index (string-match (regexp-quote hint) header))
                       (event (list 'mouse-1 (list prompt-window 'header-line '(0 . 0) 0 (cons header index))))
                       called)
                  (should index)
                  (should (eq (get-text-property index 'mouse-face header) 'highlight))
                  (select-window other-window)
                  (cl-letf (((symbol-function command)
                             (lambda ()
                               (interactive)
                               (should (eq (current-buffer) prompt))
                               (should (eq (selected-window) prompt-window))
                               (setq called t))))
                    (agent-shell-inline--click event))
                  (should called))))
            (select-window (get-buffer-window prompt))
            (agent-shell-inline-help)
            (let* ((help (buffer-local-value 'agent-shell-inline--help-buffer prompt))
                   (help-window (get-buffer-window help))
                   called)
              (select-window help-window)
              (goto-char (point-min))
              (search-forward ":wq")
              (let ((action (lookup-key (get-text-property (- (point) 3) 'keymap) [mouse-1])))
                (should (commandp action))
                (cl-letf (((symbol-function 'agent-shell-inline-send)
                           (lambda ()
                             (interactive)
                             (should (eq (current-buffer) prompt))
                             (should (eq (window-buffer) prompt))
                             (setq called t))))
                  (call-interactively action)))
              (should called)))
        (when (buffer-live-p prompt) (kill-buffer prompt))
        (kill-buffer other)))))
