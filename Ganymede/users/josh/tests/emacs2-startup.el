;;; emacs2-startup.el --- Integration checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)

(ert-deftest emacs2-project-trust-is-explicit-and-persisted ()
  (require 'flymake)
  (let* ((emacs2-projects-directory (make-temp-file "emacs2-trust-" t))
         (emacs2-trusted-projects-file (expand-file-name "trust-state" emacs2-projects-directory))
         (emacs2-trusted-projects nil)
         (trusted-content nil)
         (runs 0)
         (directory (expand-file-name "example/" emacs2-projects-directory))
         (file (expand-file-name "run.el" directory)))
    (make-directory directory)
    (with-temp-buffer
      (emacs-lisp-mode)
      (setq buffer-file-name file
            buffer-file-truename (file-truename file)
            default-directory directory)
      (emacs2-update-project-trust-status)
      (should emacs2-project-untrusted)
      (should-not (trusted-content-p))
      (setq-local flymake-diagnostic-functions
                  (list (lambda (report &rest _)
                          (setq runs (1+ runs))
                          (funcall report nil))))
      (flymake-mode 1)
      (flymake-start nil t)
      (should (= runs 0))
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) nil)))
        (emacs2-trust-project))
      (should-not (file-exists-p emacs2-trusted-projects-file))
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
        (emacs2-trust-project))
      (should (trusted-content-p))
      (should-not emacs2-project-untrusted)
      (should (> runs 0))
      (setq emacs2-trusted-projects nil trusted-content nil)
      (emacs2-load-project-trust)
      (should (trusted-content-p))
      (let ((buffer-file-truename (expand-file-name "example-other/run.el" emacs2-projects-directory)))
        (should-not (trusted-content-p)))
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (&rest _) (car emacs2-trusted-projects))))
        (emacs2-untrust-project))
      (should-not (trusted-content-p))
      (should emacs2-project-untrusted)
      (let ((previous-runs runs))
        (flymake-start nil t)
        (should (= runs previous-runs)))
      (emacs2-load-project-trust)
      (should-not emacs2-trusted-projects))))

(ert-deftest emacs2-mode-line-status-and-branch ()
  (with-temp-buffer
    (text-mode)
    (evil-normal-state)
    (should (equal (emacs2-mode-line-state-text) "N"))
    (evil-insert-state)
    (should (equal (emacs2-mode-line-state-text) "I"))
    (should (equal (emacs2-mode-line-status-text) ""))
    (insert "changed")
    (should (equal (emacs2-mode-line-status-text) "*"))
    (setq buffer-read-only t)
    (should (equal (emacs2-mode-line-status-text) "*RO"))
    (setq-local vc-mode " Git-feature/100%")
    (should (equal (emacs2-mode-line-branch-text) "  feature/100%%"))
    (setq-local vc-mode nil)
    (should-not (emacs2-mode-line-branch-text))
    (should (memq 'mode-line-format-right-align mode-line-format))
    (should-not (memq 'mode-line-modes mode-line-format))
    (emacs2-ghostel-setup)
    (should-not mode-line-format)
    (should (default-value 'mode-line-format))))

(ert-deftest emacs2-gruvbox-covers-current-packages ()
  (should (custom-theme-enabled-p 'emacs2-gruvbox))
  (should (equal (face-attribute 'default :background) "#282828"))
  (should (= (face-attribute 'default :height) 120))
  ;; Faces must also acquire the theme when their packages load later.
  (dolist (package '(embark cider cider-repl cider-test cider-debug ghostel-faces
                    markdown-mode org org-indent eglot flymake treesit-fold))
    (require package))
  (dolist (face '(vertico-current corfu-default corfu-popupinfo
                  consult-preview-line marginalia-documentation embark-target
                  eglot-inlay-hint-face flymake-error diff-hl-insert
                  cider-repl-prompt-face cider-test-success-face
                  clojure-keyword-face markdown-code-face org-block))
    (should (facep face))
    (should (assq 'emacs2-gruvbox (get face 'theme-face))))
  (should (equal (face-attribute 'ghostel-color-red :foreground nil t) "#cc241d"))
  (should (equal (face-attribute 'ghostel-color-bright-red :foreground nil t) "#fb4934"))
  (dolist (setting (get 'emacs2-gruvbox 'theme-settings))
    (when (eq (car setting) 'theme-face)
      (should-not (string-match-p "\\`\\(?:company-\\|ivy-\\|lsp-\\|org-modern-\\|vterm-\\|show-paren-\\|line-number\\)"
                                  (symbol-name (nth 1 setting)))))))

(ert-deftest emacs2-gruvbox-go-semantic-fontification ()
  (cl-letf (((symbol-function 'eglot-ensure) #'ignore))
    (with-temp-buffer
      (insert "package example\n\nfunc Value(count int) int { return count + 1 }\n")
      (go-ts-mode)
      (font-lock-ensure)
      (goto-char (point-min))
      (should (eq (get-text-property (point) 'face) 'emacs2-gruvbox-package-keyword))
      (search-forward "count")
      (should (eq (get-text-property (1- (point)) 'face) 'emacs2-gruvbox-argument))
      (search-forward "1")
      (should (eq (get-text-property (1- (point)) 'face) 'font-lock-number-face)))))

(ert-deftest emacs2-discovers-document-folders-without-visiting ()
  (let* ((emacs2-projects-directory (make-temp-file "emacs2-documents-" t))
         (project-list-file (make-temp-file "emacs2-project-list-"))
         (project--list nil)
         (first (file-name-as-directory (expand-file-name "first" emacs2-projects-directory)))
         (second (file-name-as-directory (expand-file-name "second" emacs2-projects-directory))))
    (make-directory (expand-file-name "src" first) t)
    (write-region "notes" nil (expand-file-name "notes.txt" emacs2-projects-directory) nil 'silent)
    (emacs2-discover-projects)
    (should (equal (project-known-project-roots) (list first)))
    (should (equal (project-root (project-current nil (expand-file-name "src" first))) first))
    (make-directory second)
    (emacs2-discover-projects)
    (emacs2-discover-projects)
    (should (= (length (project-known-project-roots)) 2))
    (should (member second (project-known-project-roots)))
    (should-not (emacs2-document-project emacs2-projects-directory))
    (should-not (emacs2-document-project temporary-file-directory))
    (should-not (emacs2-document-project "/ssh:example:/Documents/project/"))
    (should (file-exists-p project-list-file))))

(ert-deftest emacs2-consult-navigation-loads-and-jumps ()
  (let ((file (make-temp-file "emacs2-xref-" nil ".txt" "first\nsecond\n")))
    (unwind-protect
        (save-window-excursion
          (dolist (display (list xref-show-definitions-function xref-show-xrefs-function))
            (switch-to-buffer (get-buffer-create " *emacs2-xref-origin*"))
            (funcall display (lambda () (list (xref-make "target" (xref-make-file-location file 2 0)))))
            (should (equal buffer-file-name file))
            (should (= (line-number-at-pos) 2))))
      (when-let* ((buffer (get-file-buffer file))) (kill-buffer buffer))
      (when-let* ((buffer (get-buffer " *emacs2-xref-origin*"))) (kill-buffer buffer))))
  (dolist (command '(consult-imenu consult-flymake))
    (autoload-do-load (symbol-function command) command)
    (should (commandp command))
    (should-not (autoloadp (symbol-function command)))))

(ert-deftest emacs2-native-packages-and-startup ()
  (should minimal-emacs--success)
  (should-not init-file-had-error)
  (should (native-comp-available-p))
  (should-not minimal-emacs-package-initialize-and-refresh)
  (should-not use-package-always-ensure)
  (should (native-comp-function-p (symbol-function 'vertico-mode)))
  (dolist (package '(cider helpful bufferfile markdown-toc elisp-refs ghostel
                    evil-ghostel git-modes dumb-jump))
    (require package))
  (should-not cider-use-xref)
  (should (commandp 'cider-jack-in))
  (should (commandp 'bufferfile-rename))
  (should-not ghostel-module-auto-install))

(ert-deftest emacs2-modal-navigation ()
  (with-temp-buffer
    (text-mode)
    (evil-normal-state)
    (dolist (binding '(("SPC f" . project-find-file)
                       ("SPC b" . consult-buffer)
                       ("SPC p" . project-switch-project)
                       ("SPC ." . find-file)
                       ("SPC /" . consult-ripgrep)
                       ("SPC T n" . emacs2-ghostel-here)
                       ("SPC T s" . emacs2-ghostel-split)
                       ("G" . evil-avy-goto-char-2)
                       ("u" . undo-fu-only-undo)
                       ("U" . undo-fu-only-redo)
                       ("g d" . xref-find-definitions)
                       ("g r" . xref-find-references)))
      (should (eq (key-binding (kbd (car binding))) (cdr binding))))))

(ert-deftest emacs2-lisp-editing ()
  (require 'clojure-mode)
  (cl-letf (((symbol-function 'eglot-ensure) #'ignore))
    (dolist (mode '(emacs-lisp-mode clojure-mode clojurescript-mode clojurec-mode))
      (with-temp-buffer
        (funcall mode)
        (should paredit-mode)
        (should enhanced-evil-paredit-mode)
        (should aggressive-indent-mode)
        (should-not electric-pair-mode)
        (should yas-minor-mode)
        (evil-normal-state)
        (should (eq (key-binding (kbd "SPC f")) 'project-find-file))
        (should (eq display-line-numbers t))))))

(ert-deftest emacs2-go-and-completion ()
  (cl-letf (((symbol-function 'eglot-ensure) #'ignore))
    (with-temp-buffer
      (go-ts-mode)
      (should (treesit-parser-list))
      (should treesit-fold-mode)
      (should apheleia-mode)
      (should diff-hl-mode)
      (should (= go-ts-mode-indent-offset 4))))
  (should (eq xref-show-xrefs-function 'consult-xref))
  (should (eq xref-show-definitions-function 'consult-xref))
  (should (= which-key-idle-delay 0.01))
  (should (orderless-filter "cmpl" '("completion.el" "other.el"))))

(ert-deftest emacs2-static-language-indent-guides ()
  (cl-letf (((symbol-function 'eglot-ensure) #'ignore))
    (dolist (case '((go-ts-mode . 4) (clojure-mode . 2) (python-ts-mode . 4)
                    (nix-mode . 2) (yaml-ts-mode . 2)))
      (with-temp-buffer
        (funcall (car case))
        (should indent-bars-mode)
        (should (= (indent-bars--guess-spacing) (cdr case)))
        (should-not indent-bars-color-by-depth)
        (should-not indent-bars-highlight-current-depth)
        (should-not indent-bars-treesit-support))))
  (with-temp-buffer
    (text-mode)
    (should-not (bound-and-true-p indent-bars-mode))))

(ert-deftest emacs2-generated-files-stay-outside-projects ()
  (let* ((directory (make-temp-file "emacs2-files-" t))
         (file (expand-file-name "example.txt" directory)))
    (write-region "original\n" nil file nil 'silent)
    (with-current-buffer (find-file-noselect file)
      (unwind-protect
          (progn
            (goto-char (point-max))
            (insert "saved change\n")
            (save-buffer)
            (insert "unsaved change\n")
            (auto-save-mode 1)
            (do-auto-save t)
            (should (file-in-directory-p buffer-auto-save-file-name emacs2-state-directory))
            (should (file-exists-p buffer-auto-save-file-name))
            (should (file-in-directory-p (make-backup-file-name file) emacs2-state-directory))
            (should (equal (directory-files directory nil "^[^.]") '("example.txt"))))
        (set-buffer-modified-p nil)
        (kill-buffer (current-buffer)))))
  (dolist (file (list recentf-save-file savehist-file save-place-file
                     project-list-file bookmark-default-file undo-fu-session-directory
                     easysession-directory cider-repl-history-file))
    (should (string-prefix-p emacs2-state-directory file))))

