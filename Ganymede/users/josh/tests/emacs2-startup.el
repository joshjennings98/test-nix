  (should-not (bound-and-true-p show-paren-mode))
  (should-not (bound-and-true-p winner-mode))
  (should-not (bound-and-true-p display-time-mode))
  (should-not line-number-mode)
  (should-not column-number-mode)
  (should-not (featurep 'treemacs))
  (should-not (featurep 'vim-tab-bar)))
